{
  "name": "ai-safety-italy-website",
  "version": "1.0.0",
  "description": "AI Safety Italia Website - Built with Eleventy",
  "main": "index.js",
  "scripts": {
    "start": "run-s build:css start:watch",
    "start:watch": "npm-run-all --parallel watch:*",
    "build": "run-s clean build:css build:eleventy",
    "debug": "DEBUG=Eleventy* eleventy",
    "clean": "rimraf _site",
    "format": "prettier --write \"src/**/*.{js,md,css,html,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,md,css,html,json}\"",
    "watch:css": "tailwindcss -i src/assets/css/style.css -o _site/assets/css/style.css --watch",
    "watch:eleventy": "eleventy --serve",
    "build:css": "tailwindcss -i src/assets/css/style.css -o _site/assets/css/style.css --minify && tailwindcss -i src/assets/css/meet.css -o _site/assets/css/meet.css --minify",
    "build:eleventy": "eleventy",
    "lint": "eslint \"src/**/*.js\" --fix",
    "test": "run-s test:members test:meet",
    "verify": "npm run format:check && npx eslint server api src/assets/js && npm run build && npm run test:meet",
    "test:members": "sh scripts/run-tests.sh",
    "prepare": "husky install",
    "test:meet": "node --test server/polls.test.js server/content.test.js server/crm.test.js server/crm-mentorship.test.js server/crm-review.test.js server/forms.test.js server/members.test.js server/hardening.test.js server/overview.test.js server/retention.test.js server/app-pages.test.js server/community.test.js server/mentors-build.test.js server/highlights.test.js server/local-groups.test.js server/calendars.test.js server/calendar-reminders.test.js server/calendar-people.test.js",
    "dev:meet": "run-p meet:*",
    "meet:css": "npm run build:css && npm run watch:css",
    "meet:site": "eleventy --watch",
    "meet:server": "node scripts/meet-dev.js"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{md,css,json}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "ai-safety",
    "eleventy",
    "static-site-generator"
  ],
  "author": "AI Safety Italia",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@electric-sql/pglite": "^0.5.9",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^8.8.0",
    "husky": "^8.0.0",
    "lint-staged": "^16.2.7",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.24",
    "postcss-cli": "^10.1.0",
    "prettier": "^2.8.8",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.3.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "js-yaml": "^4.1.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.1"
  }
}
