---
title: Recordings
basePath: /streaming/
pagination:
  data: locales
  size: 1
  alias: locale
# The address used for event livestreams and recordings, printed on material
# from the October 2026 meetup. The recordings now live on /media/, so this
# only forwards there, and stays out of search results and the sitemap.
noindex: true
excludeFromSitemap: true
permalink: '{{ locale.prefix }}{{ basePath }}'
---
{%- set target = locale.prefix + "/media/" -%}
<!doctype html>
<html lang="{{ locale.code }}">
<head>
  <meta charset="utf-8">
  <meta name="robots" content="noindex">
  <meta http-equiv="refresh" content="0; url={{ target }}">
  <link rel="canonical" href="{{ target }}">
  <title>Media | AI Safety for Italy</title>
</head>
<body>
  <p><a href="{{ target }}">{{ "Vai alle registrazioni" if locale.code == "it" else "Go to the recordings" }}</a></p>
</body>
</html>
