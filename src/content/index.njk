---
title: Home
# basePath is the locale-independent path; the permalink glues the locale prefix
# in front of it, so this page is built at / and at /it/.
basePath: /
pagination:
  data: locales
  size: 1
  alias: locale
  # Without this only the first locale reaches collections.all,
  # and the sitemap would list the English pages only.
  addAllPagesToCollections: true
permalink: '{{ locale.prefix }}{{ basePath }}'
seoTitle: "AI Safety for Italy"
seoTitle_it: "AI Safety for Italy | La community italiana per la sicurezza dell'IA"
seoDescription: "AI Safety for Italy is Italy's grassroots community reducing risks from advanced AI through awareness, education, and collaboration. Open to researchers, students, and professionals."
seoDescription_it: "AI Safety for Italy è la community italiana che lavora per ridurre i rischi dell'IA avanzata attraverso divulgazione, formazione e collaborazione. Aperta a ricercatori, studenti e professionisti."
---
{% extends "base.njk" %}
{% block content %}
{# The entry flagged `featured: true` in events.yaml, if any, sits beside the
   hero. The stats strip reads its numbers from the data files, so it stays
   true as members and cities are added. #}
{% set featured = events.upcoming_events | selectattr("featured") | selectattr("hero") | first %}
{% set memberCount = members.members | length %}
{% set cityCount = about.map.cities | length %}

<!-- Hero: what we do, the next step, and the next event -->
<section class="home-hero">
    <div class="container home-hero-grid">
        <div class="home-hero-copy hero-enter">
            <img class="home-hero-logo" src="/assets/img/ais4i-logo-label.svg" alt="AI Safety for Italy logo" width="200" height="200">
            <h1 class="home-hero-title" data-en="Helping Italy prepare for advanced AI, safely." data-it="Aiutiamo l'Italia a prepararsi all'IA avanzata, in sicurezza.">Helping Italy prepare for advanced AI, safely.</h1>
            <p class="home-hero-lede" data-en="{{ translations.en.hero.description }}" data-it="{{ translations.it.hero.description }}">{{ translations.en.hero.description }}</p>
            <div class="home-hero-ctas">
                <a href="{{ home.hero.cta_link }}" class="btn btn-primary btn-lg" data-en="{{ translations.en.hero.cta }}" data-it="{{ translations.it.hero.cta }}">{{ translations.en.hero.cta }}</a>
                <a href="#what-we-do" class="btn btn-secondary btn-lg" data-en="See what we do" data-it="Cosa facciamo">See what we do</a>
            </div>
        </div>

        {% if featured %}
        {# Everything the card says comes from the entry's `hero` block in
           events.yaml, so it fits an event as well as an open call. #}
        {% set card = featured.hero %}
        <article class="event-card hero-enter" id="{{ featured.anchor }}">
            <div class="event-card-body">
                <div class="event-card-top">
                    <span class="mono-label red live-label"><span class="live-dot" aria-hidden="true"></span><span data-en="{{ card.label }}" data-it="{{ card.label_it }}">{{ card.label }}</span></span>
                    {% if card.meta %}<span class="mono-label" data-en="{{ card.meta }}" data-it="{{ card.meta_it }}">{{ card.meta }}</span>{% endif %}
                </div>
                <div class="event-card-head">
                    {% if card.day %}
                    <span class="date-badge" aria-hidden="true">
                        <span class="date-badge-month" data-en="{{ card.month }}" data-it="{{ card.month_it }}">{{ card.month }}</span>
                        <span class="date-badge-day">{{ card.day }}</span>
                    </span>
                    {% endif %}
                    <div>
                        <h2 data-en="{{ card.title }}" data-it="{{ card.title_it }}">{{ card.title }}</h2>
                        {% for line in card.lines %}
                        <p class="event-card-when" data-en="{{ line.text }}" data-it="{{ line.text_it }}">{{ line.text }}</p>
                        {% endfor %}
                    </div>
                </div>
                <p class="event-card-summary" data-en="{{ card.summary }}" data-it="{{ card.summary_it }}">{{ card.summary }}</p>
                <a href="{{ card.details_link }}" class="text-link" data-en="{{ card.details_text }}" data-it="{{ card.details_text_it }}">{{ card.details_text }}</a>
            </div>
            <div class="event-card-actions">
                <a href="{{ card.primary_link }}"{% if "://" in card.primary_link %} target="_blank" rel="noopener noreferrer"{% endif %} class="event-card-primary" data-en="{{ card.primary_text }}" data-it="{{ card.primary_text_it }}">{{ card.primary_text }}</a>
                {% if card.secondary_link %}
                <a href="{{ card.secondary_link }}"{% if "://" in card.secondary_link %} target="_blank" rel="noopener noreferrer"{% endif %} class="event-card-secondary" data-en="{{ card.secondary_text }}" data-it="{{ card.secondary_text_it }}">{{ card.secondary_text }}</a>
                {% endif %}
            </div>
        </article>
        {% endif %}
    </div>
</section>

<!-- At a glance -->
<section class="stats-strip" aria-label="At a glance">
    <div class="container stats-grid">
        <div class="stat reveal">
            <span class="stat-value" data-count="{{ memberCount }}">{{ memberCount }}</span>
            <span class="stat-label" data-en="members in the network" data-it="membri nella rete">members in the network</span>
        </div>
        <div class="stat reveal">
            <span class="stat-value" data-count="{{ cityCount }}">{{ cityCount }}</span>
            <span class="stat-label" data-en="cities" data-it="città">cities</span>
        </div>
        <div class="stat reveal">
            <span class="stat-value" data-count="2026">2026</span>
            <span class="stat-label" data-en="founded in January" data-it="fondata a gennaio">founded in January</span>
        </div>
    </div>
</section>

{% set call = home.mentorship_call %}
{% if call %}
<!-- Open call: research mentorship program -->
<section class="section call-section" id="mentorship-call">
    <div class="container">
        <div class="call-card reveal">
            <div class="call-intro">
                <span class="mono-label red live-label"><span class="live-dot" aria-hidden="true"></span><span data-en="Open call" data-it="Call aperta">Open call</span></span>
                <h2 data-en="{{ call.title }}" data-it="{{ call.title_it }}">{{ call.title }}</h2>
                <p class="call-edition" data-en="{{ call.edition }}" data-it="{{ call.edition_it }}">{{ call.edition }}</p>
                <p data-en="{{ call.description }}" data-it="{{ call.description_it }}">{{ call.description }}</p>
                <a href="/mentorship/" class="text-link" data-en="Tracks, requirements and key dates →" data-it="Percorsi, requisiti e date principali →">Tracks, requirements and key dates →</a>
                {% include "mentorship-partner.njk" %}
            </div>
            <div class="call-roles">
                <div class="call-role">
                    <h3 data-en="{{ mentorship.mentor.title }}" data-it="{{ mentorship.mentor.title_it }}">{{ mentorship.mentor.title }}</h3>
                    <p data-en="{{ call.mentor }}" data-it="{{ call.mentor_it }}">{{ call.mentor }}</p>
                    <a href="{{ mentorship.links.interest_form }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary" data-en="{{ mentorship.mentor.button }}" data-it="{{ mentorship.mentor.button_it }}">{{ mentorship.mentor.button }}</a>
                </div>
                <div class="call-role">
                    <h3 data-en="{{ mentorship.mentee.title }}" data-it="{{ mentorship.mentee.title_it }}">{{ mentorship.mentee.title }}</h3>
                    <p data-en="{{ call.mentee }}" data-it="{{ call.mentee_it }}">{{ call.mentee }}</p>
                    <a href="{{ mentorship.links.interest_form }}" target="_blank" rel="noopener noreferrer" class="btn btn-secondary" data-en="{{ mentorship.mentee.button }}" data-it="{{ mentorship.mentee.button_it }}">{{ mentorship.mentee.button }}</a>
                </div>
            </div>
        </div>
    </div>
</section>
{% endif %}

<!-- Why AI safety -->
<section class="section home-why">
    <div class="container home-why-grid">
        <div class="reveal">
            <span class="eyebrow" data-en="Why AI safety" data-it="Perché l'AI safety">Why AI safety</span>
            <h2 class="statement" data-en="AI will reshape society within our lifetimes. Making it safe is one of the most pressing problems of our time." data-it="L'IA trasformerà la società nel corso della nostra vita. Renderla sicura è una delle sfide più urgenti del nostro tempo.">AI will reshape society within our lifetimes. Making it safe is one of the most pressing problems of our time.</h2>
        </div>
        <div class="home-why-body reveal">
            <p data-en="{{ home.mission.problem_description | split('\n\n') | first }}" data-it="{{ home.mission.problem_description_it | split('\n\n') | first }}">{{ home.mission.problem_description | split('\n\n') | first }}</p>
            <p data-en="{{ home.mission.solution_description | split('\n\n') | first }}" data-it="{{ home.mission.solution_description_it | split('\n\n') | first }}">{{ home.mission.solution_description | split('\n\n') | first }}</p>
            <a href="/about/" class="text-link" data-en="About us and our approach →" data-it="Chi siamo e il nostro approccio →">About us and our approach →</a>
        </div>
    </div>
</section>

<!-- What we do -->
<section class="section" id="what-we-do">
    <div class="container">
        <div class="rule-head reveal">
            <h2 data-en="What we do" data-it="Cosa facciamo">What we do</h2>
            <a href="/initiatives/" class="text-link" data-en="All initiatives →" data-it="Tutte le iniziative →">All initiatives →</a>
        </div>
        <div class="program-grid">
            {% for feature in home.features %}
            <article class="program reveal">
                <svg class="program-icon" aria-hidden="true"><use href="#icon-{{ feature.icon }}"></use></svg>
                <h3 data-en="{{ feature.title }}" data-it="{{ feature.title_it }}">{{ feature.title }}</h3>
                <p data-en="{{ feature.description }}" data-it="{{ feature.description_it }}">{{ feature.description }}</p>
                <span class="mono-label green" data-en="{{ feature.status }}" data-it="{{ feature.status_it }}">{{ feature.status }}</span>
            </article>
            {% endfor %}
        </div>
    </div>
</section>

{# Left off the live site until the structure is approved: see `board.published`
   in data/community.yaml. Local and preview builds always show it. #}
{% if community.board.published or not site.isProduction %}
<!-- Organizing team -->
<section class="section section-alt">
    <div class="container">
        <div class="rule-head reveal">
            <h2 data-en="Organizing team" data-it="Team organizzativo">Organizing team</h2>
            <a href="/about/#board" class="text-link" data-en="About us →" data-it="Chi siamo →">About us →</a>
        </div>
        <ul class="people-grid people-grid--board">
            {% for member in team | where("tier", "leadership") | sort(false, false, "board_order") %}
            {% set parts = (member.name | replace("Dr. ", "") | trim) | split(" ") %}
            <li class="person reveal">
                {% if member.photo %}
                <img class="person-photo" src="{{ member.photo }}" alt="" loading="lazy" width="240" height="300">
                {% else %}
                <span class="person-photo person-initials" aria-hidden="true">{{ (parts | first)[0] }}{{ (parts | last)[0] if (parts | length) > 1 else "" }}</span>
                {% endif %}
                <span class="person-name">{{ member.name }}</span>
                <span class="person-role" data-en="{{ member.board_role or member.role }}" data-it="{{ member.board_role_it or member.board_role or member.role }}">{{ member.board_role or member.role }}</span>
            </li>
            {% endfor %}
            {% for seat in community.board.open_seats %}
            {% set parts = (seat.name or "") | split(" ") %}
            <li class="person person--open reveal">
                <span class="person-photo person-initials" aria-hidden="true">{{ ((parts | first)[0] ~ (parts | last)[0]) if seat.name else "?" }}</span>
                <span class="person-name">{% if seat.name %}{{ seat.name }}{% else %}<span data-en="To be defined" data-it="Da definire">To be defined</span>{% endif %}</span>
                <span class="person-role" data-en="{{ seat.role }}" data-it="{{ seat.role_it }}">{{ seat.role }}</span>
            </li>
            {% endfor %}
        </ul>
    </div>
</section>
{% endif %}

<!-- Supported by -->
<section class="supporters">
    <div class="container supporters-row reveal">
        <p class="mono-label" data-en="{{ translations.en.supporters.heading }}" data-it="{{ translations.it.supporters.heading }}">{{ translations.en.supporters.heading }}</p>
        <ul class="supporter-list">
            {% for supporter in home.supporters %}
            <li>
                <a class="supporter-logo" href="{{ supporter.url }}" target="_blank" rel="noopener noreferrer">
                    <img src="{{ supporter.logo }}" alt="{{ supporter.name }}" loading="lazy" decoding="async"{% if supporter.width %} width="{{ supporter.width }}" height="{{ supporter.height }}"{% endif %}{% if supporter.max_height %} style="max-height: {{ supporter.max_height }}px"{% endif %}>
                </a>
            </li>
            {% endfor %}
        </ul>
    </div>
</section>

<!-- Get involved -->
<section class="join-band">
    <div class="container join-grid">
        <div class="reveal">
            <h2 data-en="Get involved" data-it="Partecipa">Get involved</h2>
            <p data-en="{{ translations.en.cta.description }}" data-it="{{ translations.it.cta.description }}">{{ translations.en.cta.description }}</p>
        </div>
        <div class="join-actions reveal">
            <a href="{{ site.forms.mailingList }}" target="_blank" rel="noopener noreferrer" class="join-action">
                <span class="join-action-title" data-en="Join the community" data-it="Unisciti alla community">Join the community</span>
                <span class="join-action-text" data-en="Sign up to join our Discord and get our updates, or to help in a working group. No commitment needed." data-it="Iscriviti per entrare nel nostro Discord e ricevere aggiornamenti, o per dare una mano in un gruppo di lavoro. Nessun impegno richiesto.">Sign up to join our Discord and get our updates, or to help in a working group. No commitment needed.</span>
            </a>
            <a href="{{ site.social.linkedin }}" target="_blank" rel="noopener noreferrer" class="join-action">
                <span class="join-action-title" data-en="Follow on LinkedIn" data-it="Seguici su LinkedIn">Follow on LinkedIn</span>
                <span class="join-action-text" data-en="News, events and opportunities." data-it="Notizie, eventi e opportunità.">News, events and opportunities.</span>
            </a>
        </div>
    </div>
</section>
{% endblock %}
