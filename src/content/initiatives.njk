---
title: Initiatives
basePath: /initiatives/
pagination:
  data: locales
  size: 1
  alias: locale
  # Without this only the first locale reaches collections.all,
  # and the sitemap would list the English pages only.
  addAllPagesToCollections: true
permalink: '{{ locale.prefix }}{{ basePath }}'
seoTitle: 'Initiatives: Mentorship, Seminars & Events | AI Safety for Italy'
seoTitle_it: 'Iniziative: mentorship, seminari ed eventi | AI Safety for Italy'
seoDescription: 'Mentorship program, seminars and events from AI Safety for Italy, Italy''s grassroots AI safety community.'
seoDescription_it: "Programma di mentorship, seminari ed eventi di AI Safety for Italy, la community italiana dedicata alla sicurezza dell'IA."
---
{% extends "base.njk" %}
{% block content %}
{# Seminars and events used to be sections of this page. Links to their old
   anchors (e.g. /initiatives/#meetup-milano-2026, shared on Luma and social
   media) are sent on to the subpage that now holds them. #}
<script>
  (function () {
    var moved = {
      '#mentorship': '/mentorship/',
      '#mentorship-program': '/mentorship/',
      '#seminars': '/seminars/',
      '#events': '/events/',
      '#past-events': '/events/#past-events',
      '#meetup-milano-2026': '/events/#meetup-milano-2026'
    };
    var to = moved[location.hash];
    if (to) location.replace('{{ locale.prefix }}' + to);
  })();
</script>

<!-- Page hero -->
<section class="page-hero">
    <div class="container">
        <h1 data-en="{{ events.hero.title }}" data-it="{{ events.hero.title_it }}">{{ events.hero.title }}</h1>
        <p class="lede" data-en="{{ events.hero.subtitle }}" data-it="{{ events.hero.subtitle_it }}">{{ events.hero.subtitle }}</p>
    </div>
</section>

<!-- The three subpages -->
<section class="section">
    <div class="container">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {% for section in events.sections %}
            <article class="card news-card is-linked reveal">
                <h2 style="font-size: 1.5rem;"><a class="news-card-link" href="{{ section.link }}" data-en="{{ section.title }}" data-it="{{ section.title_it }}">{{ section.title }}</a></h2>
                <p data-en="{{ section.description }}" data-it="{{ section.description_it }}">{{ section.description }}</p>
                <span class="news-link" data-en="{{ section.link_text }}" data-it="{{ section.link_text_it }}">{{ section.link_text }}</span>
            </article>
            {% endfor %}
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="section section-alt">
    <div class="container">
        <div class="cta-band reveal">
            <h2 data-en="{{ events.cta.title }}" data-it="{{ events.cta.title_it }}">{{ events.cta.title }}</h2>
            <p data-en="{{ events.cta.description }}" data-it="{{ events.cta.description_it }}">{{ events.cta.description }}</p>
            <a href="{{ site.forms.mailingList }}" class="btn"
               target="_blank" rel="noopener noreferrer"
               data-en="{{ events.cta.button_text }}" data-it="{{ events.cta.button_text_it }}">{{ events.cta.button_text }}</a>
        </div>
    </div>
</section>
{% endblock %}
