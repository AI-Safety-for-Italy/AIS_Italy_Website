---
title: Initiatives
basePath: /initiatives/
pagination:
  data: locales
  size: 1
  alias: locale
  # Without this only the first locale reaches collections.all,
  # and the sitemap would list the English pages only.
  addAllPagesToCollections: true
permalink: '{{ locale.prefix }}{{ basePath }}'
seoTitle: 'Initiatives: Mentorship & Meetups | AI Safety for Italy'
seoTitle_it: 'Iniziative: mentorship e incontri | AI Safety for Italy'
seoDescription: 'Mentorship programs, talks and meetups from AI Safety for Italy, Italy''s grassroots AI safety community.'
seoDescription_it: "Programmi di mentorship, talk e incontri di AI Safety for Italy, la community italiana dedicata alla sicurezza dell'IA."
---
{% extends "base.njk" %}
{% block content %}
{% macro initiativeCard(event) %}
<div class="card program-card reveal"{% if event.anchor %} id="{{ event.anchor }}"{% endif %}>
    <span class="chip{% if event.status == 'Upcoming' %} red{% endif %}" data-en="{{ event.status }}" data-it="{{ event.status_it }}">{{ event.status }}</span>
    <h3 data-en="{{ event.title }}" data-it="{{ event.title_it }}">{{ event.title }}</h3>
    <div class="flex items-center gap-2 mb-4" style="font-size: 0.95rem; font-weight: 600; color: var(--text-secondary);">
        <svg class="ds-icon" style="width:1.05rem;height:1.05rem;color:var(--accent);" aria-hidden="true"><use href="#icon-calendar"></use></svg>
        <span data-en="{{ event.date }}" data-it="{{ event.date_it }}">{{ event.date }}</span>
    </div>
    {# Rendered per language (not via data-en/data-it) so the description may carry markup:
       inline <strong> in a plain one, or its own <p> and <ul> blocks. #}
    {% set description = event.description_it if lang == "it" and event.description_it else event.description %}
    {% if "<p>" in description %}
    <div class="program-description">{{ description | safe }}</div>
    {% else %}
    <p>{{ description | safe }}</p>
    {% endif %}
    {% if event.format_info %}
    <ul class="program-meta">
        {% for info in event.format_info %}
        <li>
            <strong><span data-en="{{ info.label }}" data-it="{{ info.label_it }}">{{ info.label }}</span></strong>
            <span data-en="{{ info.value }}" data-it="{{ info.value_it }}">{{ info.value }}</span>
        </li>
        {% endfor %}
    </ul>
    {% endif %}
    {% if event.agenda %}
    <div class="program-agenda-box">
        <h4 class="program-agenda-title" data-en="Agenda" data-it="Programma">Agenda</h4>
        <ul class="program-meta program-agenda">
            {% for slot in event.agenda %}
            <li>
                <strong>{{ slot.time }}</strong>
                <span data-en="{{ slot.title }}" data-it="{{ slot.title_it }}">{{ slot.title }}</span>
            </li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}
    {% if (event.register_link and event.register_text) or event.stream_text %}
    <p class="flex flex-wrap gap-3" style="margin-top: 1.5rem; margin-bottom: 0;">
        {% if event.register_link and event.register_text %}
        <a href="{{ event.register_link }}" target="{{ event.register_target }}" class="btn btn-outline"
           data-en="{{ event.register_text }}" data-it="{{ event.register_text_it }}">{{ event.register_text }}</a>
        {% endif %}
        {% if event.stream_link %}
        <a href="{{ event.stream_link }}" target="_blank" rel="noopener noreferrer" class="btn btn-outline"
           data-en="{{ event.stream_text }}" data-it="{{ event.stream_text_it }}">{{ event.stream_text }}</a>
        {% elif event.stream_text %}
        <span class="btn btn-outline is-pending" aria-disabled="true"
              data-en="{{ event.stream_text }}" data-it="{{ event.stream_text_it }}">{{ event.stream_text }}</span>
        {% endif %}
    </p>
    {% endif %}
</div>
{% endmacro %}

<!-- Page hero -->
<section class="page-hero">
    <div class="container">
        <h1 data-en="{{ events.hero.title }}" data-it="{{ events.hero.title_it }}">{{ events.hero.title }}</h1>
        <p class="lede" data-en="{{ events.hero.subtitle }}" data-it="{{ events.hero.subtitle_it }}">{{ events.hero.subtitle }}</p>
    </div>
</section>

<!-- Mentorship -->
<section class="section" id="mentorship">
    <div class="container">
        <div class="section-head reveal">
            <h2 data-en="Research mentorship program" data-it="Programma di mentorship di ricerca">Research mentorship program</h2>
        </div>
        <div class="grid grid-cols-1 gap-6" style="max-width: 48rem;">
            {% for event in events.upcoming_events %}{% if event.category == "mentorship" %}{{ initiativeCard(event) }}{% endif %}{% endfor %}
        </div>
    </div>
</section>

<!-- Seminars -->
<section class="section section-alt" id="seminars">
    <div class="container">
        <div class="section-head reveal">
            <h2 data-en="Talks &amp; meetups" data-it="Talk e incontri">Talks &amp; meetups</h2>
        </div>
        <div class="grid grid-cols-1 gap-6" style="max-width: 48rem;">
            {% for event in events.upcoming_events %}{% if event.category == "seminar" %}{{ initiativeCard(event) }}{% endif %}{% endfor %}
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="section">
    <div class="container">
        <div class="cta-band reveal">
            <h2 data-en="{{ events.cta.title }}" data-it="{{ events.cta.title_it }}">{{ events.cta.title }}</h2>
            <p data-en="{{ events.cta.description }}" data-it="{{ events.cta.description_it }}">{{ events.cta.description }}</p>
            <a href="{{ site.forms.mailingList }}" class="btn"
               target="_blank" rel="noopener noreferrer"
               data-en="{{ events.cta.button_text }}" data-it="{{ events.cta.button_text_it }}">{{ events.cta.button_text }}</a>
        </div>
    </div>
</section>
{% endblock %}
