---
title: About Us
basePath: /about/
pagination:
  data: locales
  size: 1
  alias: locale
  # Without this only the first locale reaches collections.all,
  # and the sitemap would list the English pages only.
  addAllPagesToCollections: true
permalink: '{{ locale.prefix }}{{ basePath }}'
seoTitle: 'About AI Safety for Italy: Our Mission & Community'
seoTitle_it: 'Chi siamo: la missione e la community di AI Safety for Italy'
seoDescription: "Learn about AI Safety for Italy's mission to reduce AI risks in Italy through learning, education, and community building across six working groups."
seoDescription_it: "Scopri la missione di AI Safety for Italy: ridurre i rischi dell'IA in Italia attraverso studio, divulgazione e costruzione di community, con sei gruppi di lavoro."
---
{% extends "base.njk" %}
{% block content %}
<!-- Page hero -->
<section class="page-hero">
    <div class="container">
        <span class="eyebrow" data-en="{{ translations.en.nav.about }}" data-it="{{ translations.it.nav.about }}">{{ translations.en.nav.about }}</span>
        <h1 data-en="{{ about.hero.title }}" data-it="{{ about.hero.title_it }}">{{ about.hero.title }}</h1>
        <p class="lede" data-en="{{ about.hero.subtitle }}" data-it="{{ about.hero.subtitle_it }}">{{ about.hero.subtitle }}</p>
    </div>
</section>

{% set leadership = team | where("tier", "leadership") | sort(false, false, "board_order") %}

{# Initials for people without a photo. A macro, because a {% set %} inside a
   loop does not survive it. #}
{% macro initials(name) -%}
{%- set parts = (name | replace("Dr. ", "") | trim) | split(" ") -%}
{{ (parts | first)[0] }}{{ (parts | last)[0] if (parts | length) > 1 else "" }}
{%- endmacro %}

{# Left off the live site until the structure is approved: see `board.published`
   in data/community.yaml. Local and preview builds always show it. #}
{% if community.board.published or not site.isProduction %}
<!-- Leadership team (direttivo) -->
<section class="section section-alt" id="board">
    <div class="container">
        <div class="rule-head reveal">
            <h2 data-en="Leadership team" data-it="Direttivo">Leadership team</h2>
        </div>
        {% if community.board.draft %}
        <p class="draft-note reveal" data-en="{{ community.board.note }}" data-it="{{ community.board.note_it }}">{{ community.board.note }}</p>
        {% endif %}
        <div class="board-grid">
            {% for member in leadership %}
            <article class="board-card reveal">
                {% if member.photo %}
                <img class="board-photo" src="{{ member.photo }}" alt="Portrait of {{ member.name }}" loading="lazy" width="320" height="400">
                {% else %}
                <span class="board-photo person-initials" aria-hidden="true">{{ initials(member.name) }}</span>
                {% endif %}
                <div class="board-body">
                    <h3>{{ member.name }}</h3>
                    <p class="board-role" data-en="{{ member.board_role or member.role }}" data-it="{{ member.board_role_it or member.board_role or member.role }}">{{ member.board_role or member.role }}</p>
                    {# bio_it is optional in src/data/team.js; without one the
                       English text is kept rather than blanked. #}
                    <p class="board-bio" data-en="{{ member.bio }}" data-it="{{ member.bio_it or member.bio }}">{{ member.bio }}</p>
                    {% if member.links and (member.links | length) > 0 %}
                    <div class="team-links">
                        {% for link in member.links %}
                        <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.label }}</a>
                        {% endfor %}
                    </div>
                    {% endif %}
                </div>
            </article>
            {% endfor %}
            {% for seat in community.board.open_seats %}
            <article class="board-card board-card--open reveal">
                <span class="board-photo person-initials" aria-hidden="true">{{ initials(seat.name) if seat.name else "?" }}</span>
                <div class="board-body">
                    <h3>{% if seat.name %}{{ seat.name }}{% else %}<span data-en="To be defined" data-it="Da definire">To be defined</span>{% endif %}</h3>
                    <p class="board-role" data-en="{{ seat.role }}" data-it="{{ seat.role_it }}">{{ seat.role }}</p>
                    {% if seat.description %}
                    <p class="board-bio" data-en="{{ seat.description }}" data-it="{{ seat.description_it }}">{{ seat.description }}</p>
                    {% endif %}
                    <span class="wg-badge muted" data-en="Open position" data-it="Posizione aperta">Open position</span>
                </div>
            </article>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

<!-- Working groups -->
<section class="section" id="working-groups">
    <div class="container">
        <div class="rule-head reveal">
            <h2 data-en="Working groups" data-it="Gruppi di lavoro">Working groups</h2>
            <a href="/community/" class="text-link" data-en="How to join a group →" data-it="Come entrare in un gruppo →">How to join a group →</a>
        </div>
        <div class="wg-grid">
            {% for group in community.working_groups %}
            <article class="wg-card reveal">
                <h3 data-en="{{ group.title }}" data-it="{{ group.title_it }}">{{ group.title }}</h3>
                <p data-en="{{ group.description }}" data-it="{{ group.description_it }}">{{ group.description }}</p>
                {# Everyone in the group in one list: the team first (src/data/team.js),
                   then members who joined the group through the registration form. #}
                {% set people = members.members | participants(group.form_keys, team) %}
                {% set groupTeam = team | inGroup(group.id) %}
                <div class="wg-participants">
                    <p class="wg-participants-label"><span data-en="Members" data-it="Membri">Members</span> · {{ (groupTeam | length) + (people | length) }}</p>
                    <ul class="wg-chips">
                        {% for member in groupTeam %}
                        <li class="wg-chip">{{ member.name }}</li>
                        {% endfor %}
                        {% for p in people %}
                        <li class="wg-chip">{{ p.name }}</li>
                        {% endfor %}
                    </ul>
                </div>
            </article>
            {% endfor %}
        </div>

    </div>
</section>

<!-- CTA Section -->
<section class="section">
    <div class="container">
        <div class="cta-band reveal">
            <h2 data-en="{{ about.cta.title }}" data-it="{{ about.cta.title_it }}">{{ about.cta.title }}</h2>
            <p data-en="{{ about.cta.description }}" data-it="{{ about.cta.description_it }}">{{ about.cta.description }}</p>
            <a href="{{ site.forms.mailingList }}" class="btn"
               target="_blank" rel="noopener noreferrer"
               data-en="{{ about.cta.button_text }}" data-it="{{ about.cta.button_text_it }}">{{ about.cta.button_text }}</a>
        </div>
    </div>
</section>
{% endblock %}
