                    </g>

                    <!-- Network: a faint resting line per link, plus a long
                         blurred segment that breathes its way along the same
                         curve. Each link runs out of phase with its neighbours,
                         so the whole graph shimmers rather than blinking. -->
                    <g class="map-links">
                        {% for link in about.map.links %}
                        <path class="map-link" pathLength="1" d="{{ link.d }}" style="--link-index: {{ loop.index0 }};"/>
                        {% endfor %}
                        {% for link in about.map.links %}
                        <path class="map-link-wave" pathLength="1" d="{{ link.d }}" style="--link-index: {{ loop.index0 }};"/>
                        {% endfor %}
                    </g>

                    <g class="map-pins">
                        {% for city in about.map.cities %}
                        <g class="map-pin" style="--pin-index: {{ loop.index0 }};">
                            <circle class="map-pin-halo" cx="{{ city.x }}" cy="{{ city.y }}" r="4"/>
                            <circle class="map-pin-dot" cx="{{ city.x }}" cy="{{ city.y }}" r="4"/>
                        </g>
                        {% endfor %}
                    </g>
                </svg>
            </figure>

            <div class="map-copy reveal">
                <h2 data-en="{{ about.map.title }}" data-it="{{ about.map.title_it }}">{{ about.map.title }}</h2>
                <p data-en="{{ about.map.description }}" data-it="{{ about.map.description_it }}">{{ about.map.description }}</p>
                <p data-en="{{ about.map.abroad_note }}" data-it="{{ about.map.abroad_note_it }}">{{ about.map.abroad_note }}</p>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="section">
    <div class="container">
        <div class="cta-band reveal">
            <h2 data-en="{{ about.cta.title }}" data-it="{{ about.cta.title_it }}">{{ about.cta.title }}</h2>
            <p data-en="{{ about.cta.description }}" data-it="{{ about.cta.description_it }}">{{ about.cta.description }}</p>
            <a href="{{ site.forms.mailingList }}" class="btn"
               target="_blank" rel="noopener noreferrer"
               data-en="{{ about.cta.button_text }}" data-it="{{ about.cta.button_text_it }}">{{ about.cta.button_text }}</a>
        </div>
    </div>
</section>
