---
title: Resources
basePath: /resources/
pagination:
  data: locales
  size: 1
  alias: locale
  # Without this only the first locale reaches collections.all,
  # and the sitemap would list the English pages only.
  addAllPagesToCollections: true
permalink: '{{ locale.prefix }}{{ basePath }}'
seoTitle: 'Resources | AI Safety for Italy'
seoTitle_it: 'Risorse | AI Safety for Italy'
seoDescription: "Curated links to learn about AI safety: courses, fellowships and research programmes such as MATS, Pivotal, SPAR, MARS and ERA, plus the partners and national AI safety organizations working alongside us."
seoDescription_it: "Link selezionati per studiare l'AI safety: corsi, fellowship e programmi di ricerca come MATS, Pivotal, SPAR, MARS ed ERA, oltre ai partner e alle organizzazioni nazionali che collaborano con noi."
---
{% extends "base.njk" %}
{% block content %}
<!-- Page hero -->
<section class="page-hero">
    <div class="container">
        <span class="eyebrow" data-en="{{ translations.en.nav.resources }}" data-it="{{ translations.it.nav.resources }}">{{ translations.en.nav.resources }}</span>
        <h1 data-en="{{ resources.hero.title }}" data-it="{{ resources.hero.title_it }}">{{ resources.hero.title }}</h1>
        <p class="lede" data-en="{{ resources.hero.subtitle }}" data-it="{{ resources.hero.subtitle_it }}">{{ resources.hero.subtitle }}</p>
    </div>
</section>

<!-- Featured resource -->
<section class="section">
    <div class="container">
        <div class="split-card accent-green reveal" style="text-align: center;">
            <span class="eyebrow" data-en="{{ resources.featured.label }}" data-it="{{ resources.featured.label_it }}">{{ resources.featured.label }}</span>
            <h2 data-en="{{ resources.featured.title }}" data-it="{{ resources.featured.title }}">{{ resources.featured.title }}</h2>
            <p style="max-width: 52ch; margin-left: auto; margin-right: auto;"
               data-en="{{ resources.featured.description }}" data-it="{{ resources.featured.description_it }}">{{ resources.featured.description }}</p>
            <p style="margin-top: 1.25rem; margin-bottom: 0;">
                <a href="{{ resources.featured.link_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-outline"
                   data-en="{{ resources.featured.link_text }}" data-it="{{ resources.featured.link_text_it }}">{{ resources.featured.link_text }}</a>
            </p>
        </div>
    </div>
</section>

<!-- Resource categories -->
<section class="section section-alt">
    <div class="container">
        {% for category in resources.categories %}
        <div class="resource-group">
            <h2 class="reveal"><span class="eyebrow" style="margin-bottom: 0;" data-en="{{ category.icon }} {{ category.name }}" data-it="{{ category.icon }} {{ category.name_it }}">{{ category.icon }} {{ category.name }}</span></h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for link in category.links %}
                <article class="card resource-card reveal">
                    <div class="resource-card-head">
                        {% if link.logo %}
                        <span class="resource-logo"><img src="{{ link.logo }}" alt="" width="128" height="128" loading="lazy"></span>
                        {% else %}
                        <span class="resource-logo resource-logo-mono" aria-hidden="true">{{ link.monogram }}</span>
                        {% endif %}
                        <h3 data-en="{{ link.title }}" data-it="{{ link.title }}">{{ link.title }}</h3>
                    </div>
                    <p data-en="{{ link.description }}" data-it="{{ link.description_it }}">{{ link.description }}</p>
                    <a class="news-link" href="{{ link.url }}" target="_blank" rel="noopener noreferrer">
                        <span data-en="Visit" data-it="Vai">Visit</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </a>
                </article>
                {% endfor %}
            </div>
        </div>
        {% endfor %}
    </div>
</section>

<!-- Organizations like ours -->
<section class="section">
    <div class="container">
        <div class="resource-intro reveal">
            <h2 data-en="{{ resources.organizations.title }}" data-it="{{ resources.organizations.title_it }}">{{ resources.organizations.title }}</h2>
            <p class="lede" data-en="{{ resources.organizations.subtitle }}" data-it="{{ resources.organizations.subtitle_it }}">{{ resources.organizations.subtitle }}</p>
        </div>

        {% for group in resources.organizations.groups %}
        <div class="resource-group">
            <h3 class="resource-group-title reveal"><span class="eyebrow" style="margin-bottom: 0;" data-en="{{ group.icon }} {{ group.name }}" data-it="{{ group.icon }} {{ group.name_it }}">{{ group.icon }} {{ group.name }}</span></h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for org in group.entries %}
                <article class="card resource-card reveal">
                    <div class="resource-card-head">
                        {% if org.logo %}
                        <span class="resource-logo"><img src="{{ org.logo }}" alt="" width="128" height="128" loading="lazy"></span>
                        {% else %}
                        <span class="resource-logo resource-logo-mono" aria-hidden="true">{{ org.monogram }}</span>
                        {% endif %}
                        <div class="resource-card-titles">
                            <h3 data-en="{{ org.title }}" data-it="{{ org.title }}">{{ org.title }}</h3>
                            <p class="resource-country">
                                <span aria-hidden="true">{{ org.flag }}</span>
                                <span data-en="{{ org.country }}" data-it="{{ org.country_it }}">{{ org.country }}</span>
                            </p>
                        </div>
                    </div>
                    <p data-en="{{ org.description }}" data-it="{{ org.description_it }}">{{ org.description }}</p>
                    <a class="news-link" href="{{ org.url }}" target="_blank" rel="noopener noreferrer">
                        <span data-en="Visit" data-it="Vai">Visit</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </a>
                </article>
                {% endfor %}
            </div>
        </div>
        {% endfor %}

        <div class="split-card accent-green reveal" style="text-align: center;">
            <h2 style="font-size: 1.35rem;" data-en="Know a resource we should add?" data-it="Conosci una risorsa che dovremmo aggiungere?">Know a resource we should add?</h2>
            <p data-en="Get in touch and help us grow this list for the Italian AI safety community."
               data-it="Contattaci e aiutaci a far crescere questa lista per la community italiana dell'AI safety.">Get in touch and help us grow this list for the Italian AI safety community.</p>
            <p style="margin-top: 1.25rem; margin-bottom: 0;">
                <a href="/contact/" class="btn btn-outline" data-en="Contact us" data-it="Contattaci">Contact us</a>
            </p>
        </div>
    </div>
</section>
{% endblock %}
