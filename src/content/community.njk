---
title: Community
basePath: /community/
pagination:
  data: locales
  size: 1
  alias: locale
  # Without this only the first locale reaches collections.all,
  # and the sitemap would list the English pages only.
  addAllPagesToCollections: true
permalink: '{{ locale.prefix }}{{ basePath }}'
seoTitle: 'AI Safety for Italy Community: Members & How to Join'
seoTitle_it: 'Community AI Safety for Italy: i membri e come partecipare'
seoDescription: 'Join AI Safety for Italy: how to get involved in our working groups, and the directory of community members, researchers, students and practitioners across Italy. Open to all.'
seoDescription_it: "Partecipa ad AI Safety for Italy: come entrare nei gruppi di lavoro e l'elenco dei membri della community, tra ricercatori, studenti e professionisti in tutta Italia. Aperta a tutti."
---
{% extends "base.njk" %}
{% block content %}
<!-- Page hero -->
<section class="page-hero">
    <div class="container">
        <span class="eyebrow" data-en="{{ translations.en.nav.community }}" data-it="{{ translations.it.nav.community }}">{{ translations.en.nav.community }}</span>
        <h1 data-en="{{ translations.en.community.hero_title }}" data-it="{{ translations.it.community.hero_title }}">{{ translations.en.community.hero_title }}</h1>
        <p class="lede" data-en="{{ translations.en.community.hero_subtitle }}" data-it="{{ translations.it.community.hero_subtitle }}">{{ translations.en.community.hero_subtitle }}</p>
    </div>
</section>

<!-- Two ways to take part: follow along, or contribute -->
<section class="section">
    <div class="container">
        <div class="rule-head reveal">
            <h2 data-en="Two ways to take part" data-it="Due modi per partecipare">Two ways to take part</h2>
        </div>
        <div class="ways-grid">
            <article class="way-card reveal">
                <h3 data-en="Stay up to date" data-it="Rimani aggiornato">Stay up to date</h3>
                <p data-en="Follow events, discussions and opportunities in our Discord, and receive our updates." data-it="Segui eventi, discussioni e opportunità nel nostro Discord e ricevi i nostri aggiornamenti.">Follow events, discussions and opportunities in our Discord, and receive our updates.</p>
            </article>
            <article class="way-card reveal">
                <h3 data-en="Contribute to a working group" data-it="Contribuisci a un gruppo di lavoro">Contribute to a working group</h3>
                <ol class="join-steps join-steps--stacked">
                    <li><strong data-en="Sign up and join the Discord" data-it="Iscriviti ed entra nel Discord">Sign up and join the Discord</strong></li>
                    <li><strong data-en="Pick a working group" data-it="Scegli un gruppo di lavoro">Pick a working group</strong></li>
                    <li><strong data-en="Contribute" data-it="Contribuisci">Contribute</strong></li>
                </ol>
                <a href="/about/#working-groups" class="text-link" data-en="See the working groups →" data-it="Vedi i gruppi di lavoro →">See the working groups →</a>
            </article>
        </div>
        {# Discord access goes only through the sign-up form: no direct invite link. #}
        <div class="ways-cta reveal">
            <a href="{{ site.forms.mailingList }}" rel="noopener noreferrer" class="btn btn-primary" data-en="Sign up to join the Discord" data-it="Iscriviti per entrare nel Discord">Sign up to join the Discord</a>
            <p class="ways-cta-note" data-en="Both paths start from the same form. Once your sign-up is accepted, you'll get access to the Discord." data-it="Entrambi i percorsi partono dallo stesso modulo. Una volta accettata l'iscrizione, riceverai l'accesso al Discord.">Both paths start from the same form. Once your sign-up is accepted, you'll get access to the Discord.</p>
        </div>
    </div>
</section>

<!-- Local groups — animated stylised map of Italy beside the list of cities.
     Outline geometry is derived from Natural Earth (public domain) via
     world-atlas, Mercator-projected and simplified into this viewBox.
     The draw-in, fill and dot animations all key off .is-visible, which the
     shared scroll-reveal observer in base.njk adds. That observer applies
     .is-visible immediately under prefers-reduced-motion, and the CSS
     disables the motion in that case, so the map just appears.
     The cities come from Site content → Local groups once published there
     (server/local-groups-build.js); a city with a `link` (its WhatsApp
     group, its own site…) opens it, the others are plain names. -->
{% set groups = community.local_groups %}
<section class="section section-alt" id="local-groups">
    <div class="container">
        <div class="map-layout">
            <figure class="map-figure reveal">
                <svg class="italy-map" viewBox="0 0 420 560" role="img"
                     aria-label="Stylised map of Italy marking the cities with a local AI Safety for Italy group">
                    <defs>
                        <linearGradient id="italyStroke" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="var(--accent)"/>
                            <stop offset="100%" stop-color="var(--accent-400)"/>
                        </linearGradient>
                        <filter id="pinGlow" x="-120%" y="-120%" width="340%" height="340%">
                            <feGaussianBlur stdDeviation="2.4" result="b"/>
                            <feMerge>
                                <feMergeNode in="b"/>
                                <feMergeNode in="SourceGraphic"/>
                            </feMerge>
                        </filter>
                    </defs>
                    {% include "italy-map-land.njk" %}

                    <g class="map-pins">
                        {% for city in groups.cities %}
                        <g class="map-pin" style="--pin-index: {{ loop.index0 }};">
                            <circle class="map-pin-halo" cx="{{ city.x }}" cy="{{ city.y }}" r="4"/>
                            <circle class="map-pin-dot" cx="{{ city.x }}" cy="{{ city.y }}" r="4"/>
                            {%- if city.link %}
                            <a href="{{ city.link }}" target="_blank" rel="noopener noreferrer"><text class="map-pin-label is-link" x="{{ city.x + 8 }}" y="{{ city.y + 4 }}">{{ city.name }}</text></a>
                            {%- else %}
                            <text class="map-pin-label" x="{{ city.x + 8 }}" y="{{ city.y + 4 }}">{{ city.name }}</text>
                            {%- endif %}
                        </g>
                        {% endfor %}
                    </g>
                </svg>
            </figure>

            <div class="map-copy reveal">
                <h2 data-en="{{ groups.title }}" data-it="{{ groups.title_it }}">{{ groups.title }}</h2>
                <ul class="group-list">
                    {% for city in groups.cities %}
                    {%- if city.link %}
                    <li><a class="group-chip is-link" href="{{ city.link }}" target="_blank" rel="noopener noreferrer">{{ city.name }}&nbsp;↗</a></li>
                    {%- else %}
                    <li class="group-chip">{{ city.name }}</li>
                    {%- endif %}
                    {% endfor %}
                </ul>
                <p class="group-join"><a href="{{ site.forms.mailingList }}" target="_blank" rel="noopener noreferrer" class="text-link" data-en="{{ groups.join }}&nbsp;→" data-it="{{ groups.join_it }}&nbsp;→">{{ groups.join }}&nbsp;→</a></p>
                <p class="group-start">
                    <span data-en="{{ groups.start }}" data-it="{{ groups.start_it }}">{{ groups.start }}</span>
                    <a href="{{ site.forms.mailingList }}" target="_blank" rel="noopener noreferrer" class="text-link" data-en="{{ groups.start_link }}&nbsp;→" data-it="{{ groups.start_link_it }}&nbsp;→">{{ groups.start_link }}&nbsp;→</a>
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Members Table Section -->
<section class="section" id="members">
    <div class="container">
        <div class="section-head reveal">
            <span class="eyebrow" data-en="Directory" data-it="Elenco">Directory</span>
            <h2 data-en="{{ translations.en.community.members_title }}" data-it="{{ translations.it.community.members_title }}">{{ translations.en.community.members_title }}</h2>
            <p data-en="People who have joined the community and agreed to be listed." data-it="Persone iscritte alla community che hanno accettato di comparire qui.">People who have joined the community and agreed to be listed.</p>
            <p class="table-note" data-en="Last updated: {{ members.last_updated }}" data-it="Ultimo aggiornamento: {{ members.last_updated }}">Last updated: {{ members.last_updated }}</p>
        </div>

        <!-- Search + sort bar -->
        <div class="flex flex-col sm:flex-row gap-3 mb-6">
            <input id="tbl-search" type="text" placeholder="Search name…"
                oninput="filterTable()"
                class="form-input flex-1"
                aria-label="{{ t.a11y.search_members }}"
                data-placeholder-en="Search name…" data-placeholder-it="Cerca nome…">
            <select id="tbl-sort" onchange="filterTable()"
                class="form-input sm:w-auto"
                aria-label="{{ t.a11y.sort_members }}">
                <option value="surname-asc" data-en="Surname A→Z" data-it="Cognome A→Z">Surname A→Z</option>
                <option value="surname-desc" data-en="Surname Z→A" data-it="Cognome Z→A">Surname Z→A</option>
            </select>
        </div>

        <div class="table-wrap reveal" style="max-height: 480px; overflow-y: auto;">
            <table>
                <thead>
                    <tr>
                        <th scope="col" style="position: sticky; top: 0; z-index: 1;" data-en="Name" data-it="Nome">Name</th>
                        <th scope="col" style="position: sticky; top: 0; z-index: 1;" data-en="Location" data-it="Posizione">Location</th>
                        <th scope="col" style="position: sticky; top: 0; z-index: 1;" data-en="Areas of Interest" data-it="Aree di interesse">Areas of Interest</th>
                    </tr>
                </thead>
                <tbody id="members-tbody">
                    {% for member in members.members %}
                    <tr class="member-row" data-name="{{ member.name | lower }}">
                        <td>
                            <div class="flex items-center gap-2">
                                <span class="member-initial" aria-hidden="true">{{ member.name | first }}</span>
                                <div>
                                    <strong style="color: var(--text-primary);">{{ member.name }}</strong>
                                    {% if member.profile %}
                                    <div class="member-links">
                                    {% for raw in member.profile | split(",") %}
                                    {% set url = raw | trim %}
                                    {% if url %}
                                    {#- Only a link that starts with http(s):// is used as it is: anything else (javascript:…) gets https:// in front. -#}
                                    {% set href = url if (url.indexOf("https://") == 0 or url.indexOf("http://") == 0) else "https://" + url %}
                                    {% set label = url | replace("https://", "") | replace("http://", "") | replace("www.", "") %}
                                    <a href="{{ href }}" target="_blank" rel="noopener noreferrer">{{ label }}</a>
                                    {% endif %}
                                    {% endfor %}
                                    </div>
                                    {% endif %}
                                </div>
                            </div>
                        </td>
                        <td>{{ member.location or '' }}</td>
                        <td style="font-size: 0.85rem;">{{ member.areas or '' }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <p id="tbl-count" class="table-note text-right"></p>
        <p class="table-note reveal">
            <span data-en="Want to be part of this list?" data-it="Vuoi far parte di questa lista?">Want to be part of this list?</span>
            <a href="{{ site.forms.mailingList }}" rel="noopener noreferrer"><span data-en="{{ translations.en.community.join_button }}" data-it="{{ translations.it.community.join_button }}">{{ translations.en.community.join_button }}</span></a>
            <span data-en="and get involved." data-it="e partecipa.">and get involved.</span>
        </p>
    </div>
</section>

<!-- CTA Section -->
<section class="section">
    <div class="container">
        <div class="cta-band reveal">
            <h2 data-en="{{ translations.en.community.cta_title }}" data-it="{{ translations.it.community.cta_title }}">{{ translations.en.community.cta_title }}</h2>
            <p data-en="{{ translations.en.community.cta_description }}" data-it="{{ translations.it.community.cta_description }}">{{ translations.en.community.cta_description }}</p>
            <a href="{{ site.forms.mailingList }}" class="btn"
               target="_blank" rel="noopener noreferrer"
               data-en="{{ translations.en.community.cta_button }}"
               data-it="{{ translations.it.community.cta_button }}">{{ translations.en.community.cta_button }}</a>
        </div>
    </div>
</section>

<script>
(function () {
    function surname(row) {
        const parts = row.dataset.name.trim().split(' ');
        return parts[parts.length - 1];
    }

    function filterTable() {
        const search = (document.getElementById('tbl-search').value || '').toLowerCase();
        const sort   = document.getElementById('tbl-sort').value;

        const rows = Array.from(document.querySelectorAll('.member-row'));
        let visible = rows.filter(r => !search || r.dataset.name.includes(search));

        visible.sort((a, b) => sort === 'surname-desc'
            ? surname(b).localeCompare(surname(a))
            : surname(a).localeCompare(surname(b)));

        const tbody = document.getElementById('members-tbody');
        rows.forEach(r => r.style.display = 'none');
        visible.forEach(r => { r.style.display = ''; tbody.appendChild(r); });

        const count = document.getElementById('tbl-count');
        if (count) {
            // Each language is its own page, so the document's own lang is the
            // authority here — there is no client-side language state.
            const lang = document.documentElement.lang || 'en';
            const unit = lang === 'it'
                ? (visible.length !== 1 ? ' membri' : ' membro')
                : (visible.length !== 1 ? ' members' : ' member');
            count.textContent = visible.length + unit;
        }
    }
    window.filterTable = filterTable;

    document.addEventListener('DOMContentLoaded', function () {
        filterTable();
    });
})();
</script>
{% endblock %}
