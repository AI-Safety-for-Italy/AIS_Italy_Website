---
title: Poll
permalink: /admin/poll/
noindex: true
excludeFromSitemap: true
eleventyExcludeFromCollections: true
adminTab: poll
seoTitle: 'Poll | AI Safety for Italy'
---
{% extends "base.njk" %}
{% block content %}
<section class="page-hero meet-hero">
  <div class="container">
    <span class="eyebrow">Admin · Meeting poll <span id="statusBadge"></span></span>
    <h1 id="pollTitle">&nbsp;</h1>
    <div class="meet-meta" id="pollMeta"></div>
  </div>
</section>

<section class="meet-main">
  <div class="container">
    {% include "admin-bar.njk" %}
    <div id="pollView"></div>
  </div>
</section>

<dialog class="meet-dialog" id="finalizeDialog" aria-labelledby="finalizeTitle">
  <form method="dialog" id="finalizeForm">
    <div class="dialog-body form-grid">
      <div>
        <span class="label-mono">Send the invite</span>
        <h2 id="finalizeTitle"></h2>
        <p class="panel-note" id="finalizeWhen"></p>
      </div>
      <div class="notice" id="finalizeCalendarNotice" hidden>
        <span>⚠</span><span>Google Calendar is not connected.</span>
      </div>
      <div>
        <span class="form-label">Invite</span>
        <div class="invitee-list" id="inviteeList"></div>
      </div>
      <div>
        <label class="form-label" for="extraEmails">Other guests <span class="panel-note">(optional)</span></label>
        <textarea class="form-input is-compact is-short" id="extraEmails" placeholder="name@example.org"></textarea>
      </div>
      <label class="check-row">
        <input type="checkbox" id="createMeet">
        <span>Add a Google Meet video call</span>
      </label>
      <div class="form-error" id="finalizeError" role="alert" hidden></div>
    </div>
    <div class="dialog-foot">
      <button class="btn btn-outline btn-sm" value="cancel" formnovalidate>Cancel</button>
      <button class="btn btn-primary btn-sm" type="submit" id="finalizeSubmit" value="send">Send calendar invite</button>
    </div>
  </form>
</dialog>

<script src="/assets/js/meet/common.js" defer></script>
<script src="/assets/js/meet/admin-common.js" defer></script>
<script src="/assets/js/meet/admin-poll.js" defer></script>
{% endblock %}
