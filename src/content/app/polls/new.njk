---
title: New poll
permalink: /app/polls/new/
noindex: true
excludeFromSitemap: true
eleventyExcludeFromCollections: true
seoTitle: 'New poll | AI Safety for Italy'
tool: polls
tab: new
---
{% extends "app.njk" %}
{% block page %}

    <form id="pollForm" novalidate>
      <div class="create-layout">
        <div class="panel form-grid">
          <div>
            <label class="form-label" for="title">Title</label>
            <input class="form-input is-compact" id="title" name="title" maxlength="200" required placeholder="e.g. Board meeting">
          </div>
          <div>
            <label class="form-label" for="description">Description <span class="panel-note">(optional)</span></label>
            <textarea class="form-input is-compact is-short" id="description" name="description" maxlength="5000" placeholder="Agenda, context…"></textarea>
          </div>
          <div>
            <label class="form-label" for="location">Location <span class="panel-note">(optional)</span></label>
            <input class="form-input is-compact" id="location" name="location" maxlength="500" placeholder="Address or link">
          </div>
          <div>
            <span class="form-label" id="durationLabel">Duration</span>
            <div class="chip-group" role="group" aria-labelledby="durationLabel" id="durationChips">
              <button type="button" class="chip" data-minutes="30">30 min</button>
              <button type="button" class="chip" data-minutes="45">45 min</button>
              <button type="button" class="chip" data-minutes="60">1 h</button>
              <button type="button" class="chip" data-minutes="90">1 h 30</button>
              <button type="button" class="chip" data-minutes="120">2 h</button>
              <label class="chip-custom">
                <input class="form-input" type="number" id="durationCustom" min="5" max="1440" step="5" aria-label="Custom duration in minutes"> min
              </label>
            </div>
          </div>
          {% set rp = "new" %}{% include "recurrence-fields.njk" %}
          <div>
            <label class="form-label" for="timezone">Time zone</label>
            <select class="form-input is-compact" id="timezone" name="timezone"></select>
          </div>
          <div>
            <label class="form-label" for="deadline">Voting deadline <span class="panel-note">(optional)</span></label>
            <input class="form-input is-compact" id="deadline" name="deadline" type="datetime-local">
          </div>
          <div>
            <span class="form-label" id="audienceLabel">Who can answer</span>
            <div class="choice-group" role="radiogroup" aria-labelledby="audienceLabel">
              <label class="choice"><input type="radio" name="audience" value="link" checked><span>Anyone with the link</span></label>
              <label class="choice"><input type="radio" name="audience" value="invite"><span>Only people I invite</span></label>
            </div>
            <p class="form-note" id="inviteNote" hidden style="margin-top:.4rem">Needs email sending, which the admin sets up in Settings.</p>
          </div>
          <div id="inviteesRow" hidden>
            <label class="form-label" for="invitees">Guests’ emails</label>
            <textarea class="form-input is-compact is-short" id="invitees" placeholder="anna@example.org, marco@example.org"></textarea>
            <p class="form-note" style="margin-top:.4rem">Each gets a personal link by email.</p>
          </div>
          <label class="check-row">
            <input type="checkbox" id="hideResponses" name="hideResponses">
            <span>Hide answers from participants</span>
          </label>
          <label class="check-row">
            <input type="checkbox" id="notify" name="notify" checked>
            <span>Notify me about new answers</span>
          </label>
        </div>

        <div class="panel">
          <div class="wk-toolbar">
            <h2 class="wk-range" id="wkRange"></h2>
            <div class="wk-nav">
              <button type="button" class="btn btn-outline btn-sm" id="wkToday">Today</button>
              <button type="button" class="icon-btn" id="wkPrev" aria-label="Previous days"></button>
              <button type="button" class="icon-btn" id="wkNext" aria-label="Next days"></button>
            </div>
          </div>
          <p class="wk-hint">Click or drag to add times, even overlapping ones · × removes a time</p>
          <div class="wk" id="wk"></div>
          <div class="slot-summary" id="slotSummary"></div>
        </div>
      </div>

      <div class="form-error" id="formError" role="alert" hidden style="margin-top:1.25rem"></div>

      <div class="action-bar">
        <p id="slotCount"></p>
        <button class="btn btn-primary" type="submit" id="createBtn">Create poll</button>
      </div>
    </form>

<script src="/assets/js/meet/common.js" defer></script>
<script src="/assets/js/meet/app-common.js" defer></script>
<script src="/assets/js/meet/poll-new.js" defer></script>
{% endblock %}
