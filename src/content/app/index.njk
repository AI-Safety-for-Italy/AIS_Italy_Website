---
title: Home
# Landing page after sign-in: what waits for the member in each tool, the
# tools their roles open. Tools come from src/data/tools.js (their actions
# are offered by the search, Ctrl+K);
# the counts from /api/app/overview (hub.js).
permalink: /app/
noindex: true
excludeFromSitemap: true
eleventyExcludeFromCollections: true
seoTitle: 'Personal area | AI Safety for Italy'
pageTitle: Home
---
{% extends "app.njk" %}
{% block page %}
<div class="hub">
  <div class="hub-head">
    <div>
      <p class="hub-date" id="hubDate"></p>
      <h2 class="hub-hello" id="hello">Hi</h2>
      <script>
        /* Greet last visit's user at once; hub.js confirms it. */
        (function () {
          try {
            var u = JSON.parse(localStorage.getItem('ais-user') || 'null');
            if (u && u.name) document.getElementById('hello').textContent = 'Hi, ' + u.name.split(' ')[0];
          } catch (e) {}
        })();
      </script>
    </div>
  </div>

  <section aria-labelledby="hubTodoTitle">
    <h3 class="ap-section-title" id="hubTodoTitle">Waiting for you</h3>
    <div class="hub-todo" id="hubTodo">
      <div class="hub-todo-card is-loading" aria-hidden="true"></div>
      <div class="hub-todo-card is-loading" aria-hidden="true"></div>
    </div>
  </section>

  <section aria-labelledby="hubToolsTitle">
    <h3 class="ap-section-title" id="hubToolsTitle">Your tools</h3>
    <div class="hub-tools">
      {%- for t in tools %}
      {%- if t.sections %}
      {#- A tool in parts (Site content): the box opens the tool, and each part
          has its own link, shown to whoever holds that part's key. #}
      <div class="hub-tool has-parts"{% if t.area %} data-area="{{ t.area }}" hidden{% endif %}{% if t.needsAny %} data-needs-any="{{ t.needsAny | join(' ') }}"{% endif %}>
        <span class="hub-tool-icon hub-tool-icon--{{ t.key }}" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{{ t.icon | safe }}</svg></span>
        <span class="hub-tool-body">
          <a class="hub-tool-link" href="{{ t.url }}"><strong>{{ t.title }}</strong></a>
          <span>{{ t.text }}</span>
          <span class="hub-tool-parts">
            {%- for s in t.sections %}
            <a class="hub-tool-part" href="{{ s.url }}" data-needs="{{ s.needs }}" hidden>{{ s.label }}</a>
            {%- endfor %}
          </span>
        </span>
      </div>
      {%- else %}
      <a class="hub-tool" href="{{ t.url }}"{% if t.area %} data-area="{{ t.area }}" hidden{% endif %}{% if t.needsAny %} data-needs-any="{{ t.needsAny | join(' ') }}"{% endif %}>
        <span class="hub-tool-icon hub-tool-icon--{{ t.key }}" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{{ t.icon | safe }}</svg></span>
        <span class="hub-tool-body">
          <strong>{{ t.title }}</strong>
          <span>{{ t.text }}</span>
        </span>
      </a>
      {%- endif %}
      {%- endfor %}
    </div>
  </section>
</div>

<script src="/assets/js/meet/common.js?v={{ build }}" defer></script>
<script src="/assets/js/meet/app-common.js?v={{ build }}" defer></script>
<script src="/assets/js/meet/hub.js?v={{ build }}" defer></script>
{% endblock %}
