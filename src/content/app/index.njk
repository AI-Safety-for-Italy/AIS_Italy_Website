---
title: Tools
# Landing page after sign-in: the tools a member can use. Add a card here for
# each new tool.
permalink: /app/
noindex: true
excludeFromSitemap: true
eleventyExcludeFromCollections: true
seoTitle: 'Personal area | AI Safety for Italy'
tools:
  - title: Meeting polls
    url: /app/polls/
    icon: calendar
    text: Propose times and find the one that works for everyone.
---
{% extends "base.njk" %}
{% block content %}
<section class="page-hero meet-hero">
  <div class="container">
    <span class="eyebrow">Personal area</span>
    <h1 id="hello">Tools</h1>
    <script>
      /* Greet last visit's user at once; hub.js confirms it. */
      (function () {
        try {
          var u = JSON.parse(localStorage.getItem('ais-user') || 'null');
          if (u && u.name) document.getElementById('hello').textContent = 'Ciao, ' + u.name.split(' ')[0];
        } catch (e) {}
      })();
    </script>
  </div>
</section>

<section class="meet-main">
  <div class="container">
    <div class="tool-grid">
      {%- for tool in tools %}
      <a class="tool-card" href="{{ tool.url }}">
        <span class="tool-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="2.5"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4M8 14h3"/></svg>
        </span>
        <span class="tool-body">
          <strong>{{ tool.title }}</strong>
          <span>{{ tool.text }}</span>
        </span>
      </a>
      {%- endfor %}
      {# Shown by hub.js to members whose Discord roles allow publishing something. #}
      <a class="tool-card" href="/app/content/" id="contentTool" hidden>
        <span class="tool-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16v4z"/><path d="M13.5 6.5l4 4"/></svg>
        </span>
        <span class="tool-body">
          <strong>Site content</strong>
          <span>Publish seminars and events on the website.</span>
        </span>
      </a>
      <div class="tool-card is-soon" aria-hidden="true">
        <span class="tool-body"><strong>More tools</strong><span>Coming later.</span></span>
      </div>
    </div>
  </div>
</section>

<script src="/assets/js/meet/common.js" defer></script>
<script src="/assets/js/meet/app-common.js" defer></script>
<script src="/assets/js/meet/hub.js" defer></script>
{% endblock %}
