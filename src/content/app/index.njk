---
title: Home
# Landing page after sign-in: what waits for the member in each tool, the
# tools their roles open, and quick actions. Tools come from src/data/tools.js;
# the counts from /api/app/overview (hub.js).
permalink: /app/
noindex: true
excludeFromSitemap: true
eleventyExcludeFromCollections: true
seoTitle: 'Personal area | AI Safety for Italy'
pageTitle: Home
---
{% extends "app.njk" %}
{% block page %}
<div class="hub">
  <div class="hub-head">
    <div>
      <p class="hub-date" id="hubDate"></p>
      <h2 class="hub-hello" id="hello">Ciao</h2>
      <script>
        /* Greet last visit's user at once; hub.js confirms it. */
        (function () {
          try {
            var u = JSON.parse(localStorage.getItem('ais-user') || 'null');
            if (u && u.name) document.getElementById('hello').textContent = 'Ciao, ' + u.name.split(' ')[0];
          } catch (e) {}
        })();
      </script>
    </div>
    <div class="hub-actions" id="hubActions">
      {%- for t in tools %}{% for a in t.actions %}
      <a class="btn {% if t.key == 'polls' %}btn-primary{% else %}btn-outline{% endif %} btn-sm" href="{{ a.url }}"{% if a.needs %} data-needs="{{ a.needs }}" hidden{% elif t.area %} data-area="{{ t.area }}" hidden{% endif %}>{{ a.label }}</a>
      {%- endfor %}{% endfor %}
    </div>
  </div>

  <section aria-labelledby="hubTodoTitle">
    <h3 class="ap-section-title" id="hubTodoTitle">Waiting for you</h3>
    <div class="hub-todo" id="hubTodo">
      <div class="hub-todo-card is-loading" aria-hidden="true"></div>
      <div class="hub-todo-card is-loading" aria-hidden="true"></div>
    </div>
  </section>

  <section aria-labelledby="hubToolsTitle">
    <h3 class="ap-section-title" id="hubToolsTitle">Your tools</h3>
    <div class="hub-tools">
      {%- for t in tools %}
      <a class="hub-tool" href="{{ t.url }}"{% if t.area %} data-area="{{ t.area }}" hidden{% endif %}>
        <span class="hub-tool-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{{ t.icon | safe }}</svg></span>
        <span class="hub-tool-body">
          <strong>{{ t.title }}</strong>
          <span>{{ t.text }}</span>
        </span>
      </a>
      {%- endfor %}
    </div>
  </section>
</div>

<script src="/assets/js/meet/common.js" defer></script>
<script src="/assets/js/meet/app-common.js" defer></script>
<script src="/assets/js/meet/hub.js" defer></script>
{% endblock %}
