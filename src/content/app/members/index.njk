---
title: Member applications
# The registration form's submissions, approved or rejected here; approving
# emails a link that adds the person to the Discord server with their role
# (server/members.js). Needs the `members` permission.
permalink: /app/members/
tool: members
tab: applications
noindex: true
excludeFromSitemap: true
eleventyExcludeFromCollections: true
seoTitle: 'Member applications | AI Safety for Italy'
---
{% extends "app.njk" %}
{% block page %}
    <div class="notice" id="setupNote" hidden style="margin-bottom:1.5rem"><span id="setupText"></span></div>
    <div class="panel-head">
      <div class="choice-group" role="radiogroup" aria-label="Show" id="filters"></div>
      <label class="fl-notify members-follow" id="followBoard" hidden title="Hear about new applications, on your channel from Settings"><span>Notify me</span><input type="checkbox" role="switch" class="fe-switch-input" id="followInput"></label>
    </div>
    <div id="memberList"></div>

<script src="/assets/js/meet/common.js?v={{ build }}" defer></script>
<script src="/assets/js/meet/app-common.js?v={{ build }}" defer></script>
<script src="/assets/js/meet/members.js?v={{ build }}" defer></script>
{% endblock %}
