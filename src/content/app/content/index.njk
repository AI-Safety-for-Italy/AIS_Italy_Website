---
title: Site content
# The content tool: seminars and events published straight to the site by the
# members whose Discord roles allow it (server/content.js).
permalink: /app/content/
appTab: content
noindex: true
excludeFromSitemap: true
eleventyExcludeFromCollections: true
seoTitle: 'Site content | AI Safety for Italy'
---
{% extends "base.njk" %}
{% block content %}
<section class="page-hero meet-hero">
  <div class="container">
    <span class="eyebrow">Personal area</span>
    <h1>Site content</h1>
  </div>
</section>

<section class="meet-main">
  <div class="container">
    {% include "content-bar.njk" %}
    {# One <span>: .notice lays out its children side by side (icon + text). #}
    <div class="notice" id="notLive" hidden style="margin-bottom:1.5rem">
      <span><strong>Not switched on yet.</strong> What you publish here is saved, but the site still shows the seminars and events written in the code, until the content is moved over (<code>scripts/content-migrate.js</code>, see server/README.md).</span>
    </div>
    <div class="panel-head">
      <h2>Seminars &amp; events</h2>
      <div class="wk-nav">
        <a class="btn btn-primary btn-sm" href="/app/content/edit/?type=seminar" data-needs="seminar" hidden>+ New seminar</a>
        <a class="btn btn-outline btn-sm" href="/app/content/edit/?type=event" data-needs="event" hidden>+ New event</a>
      </div>
    </div>
    <div id="contentList"></div>
    <div class="panel content-activity" id="activityPanel" hidden>
      <div class="panel-head"><h2>Recent changes</h2></div>
      <ul class="activity-list" id="activity"></ul>
    </div>
  </div>
</section>

<script src="/assets/js/meet/common.js" defer></script>
<script src="/assets/js/meet/app-common.js" defer></script>
<script src="/assets/js/meet/content-common.js" defer></script>
<script src="/assets/js/meet/content-list.js" defer></script>
{% endblock %}
