---
title: Site content
# The content tool's page: a box per part (`sections` of the tool in
# src/data/tools.js), shown to whoever holds its key, with who holds it.
# Each box opens that part's list (seminars.njk, events.njk).
permalink: /app/content/
tool: content
noindex: true
excludeFromSitemap: true
eleventyExcludeFromCollections: true
seoTitle: 'Site content | AI Safety for Italy'
---
{% extends "app.njk" %}
{% block page %}
    {%- set contentTool = tools | where("key", "content") | first %}
    <p class="panel-note" style="margin:0 0 1rem">What you can publish on the site.</p>
    <div class="hub-tools content-parts">
      {%- for s in contentTool.sections %}
      <div class="hub-tool content-part" data-needs="{{ s.needs }}" hidden>
        <span class="hub-tool-icon hub-tool-icon--content" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{{ s.icon | safe }}</svg></span>
        <span class="hub-tool-body">
          <a class="content-part-link" href="{{ s.url }}"><strong>{{ s.label }}</strong></a>
          <span>{{ s.text }}</span>
          <span class="content-part-faces" data-section="{{ s.key }}"></span>
        </span>
      </div>
      {%- endfor %}
    </div>
    <div class="empty-state" id="contentNone" hidden>
      <h3>No access</h3>
      <p>Your roles do not let you publish anything on the site yet.</p>
    </div>

<script src="/assets/js/meet/common.js?v={{ build }}" defer></script>
<script src="/assets/js/meet/app-common.js?v={{ build }}" defer></script>
<script src="/assets/js/meet/content-home.js?v={{ build }}" defer></script>
{% endblock %}
