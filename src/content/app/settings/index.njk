---
title: Settings
tool: settings
tab: notifications
permalink: /app/settings/
noindex: true
excludeFromSitemap: true
eleventyExcludeFromCollections: true
seoTitle: 'Settings | AI Safety for Italy'
---
{% extends "app.njk" %}
{% block page %}
    <div class="settings">
    <form class="panel form-grid" id="notifyForm" novalidate>
      <div class="panel-head" style="margin:0">
        <h2>Where you hear from us</h2>
      </div>
      <p class="panel-note" style="margin:0">You are told only about what you follow (below), never about everything you can see. Choose where it reaches you.</p>
      <div class="notify-channels" role="radiogroup" aria-label="Where notifications go">
        <label class="notify-channel">
          <input type="radio" name="channel" value="email">
          <span class="notify-channel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span>
          <span class="notify-channel-text"><strong>Email</strong><small>To the address below.</small></span>
        </label>
        <label class="notify-channel">
          <input type="radio" name="channel" value="discord">
          <span class="notify-channel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg></span>
          <span class="notify-channel-text"><strong>Discord</strong><small>A direct message from the AIS bot.</small></span>
        </label>
        <label class="notify-channel">
          <input type="radio" name="channel" value="both">
          <span class="notify-channel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8h.01M10 8h8M6 12h.01M10 12h8M6 16h.01M10 16h8"/></svg></span>
          <span class="notify-channel-text"><strong>Both</strong><small>Email and a Discord message.</small></span>
        </label>
        <label class="notify-channel">
          <input type="radio" name="channel" value="none">
          <span class="notify-channel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 9.3-5M18 8c0 7 3 9 3 9H9M13.7 21a2 2 0 0 1-3.4 0M3 3l18 18"/></svg></span>
          <span class="notify-channel-text"><strong>Off</strong><small>Nothing, anywhere.</small></span>
        </label>
      </div>
      <p class="notice" id="discordNote" hidden style="margin:0"><span>ⓘ</span><span id="discordNoteText"></span></p>
      <div id="notifyEmailRow">
        <label class="form-label" for="notifyEmail">Email for notifications</label>
        <input class="form-input is-compact" id="notifyEmail" type="email" autocomplete="email">
        <p class="form-note" id="notifyEmailHint" style="margin:0.35rem 0 0"></p>
      </div>
      <div class="form-error" role="alert" hidden></div>
      <div><button class="btn btn-primary btn-sm" type="submit">Save</button></div>
    </form>

    <section class="panel form-grid" id="followPanel" hidden>
      <div class="panel-head" style="margin:0">
        <h2>What you follow</h2>
      </div>
      <p class="panel-note" style="margin:0">Each switch on means you are told about it, and it counts on your home page. The same switch is on each card of the forms and the polls, and on the member applications page.</p>
      <div class="follow-list" id="followList"></div>
    </section>
    </div>

<script src="/assets/js/meet/common.js?v={{ build }}" defer></script>
<script src="/assets/js/meet/app-common.js?v={{ build }}" defer></script>
<script src="/assets/js/meet/settings.js?v={{ build }}" defer></script>
{% endblock %}
