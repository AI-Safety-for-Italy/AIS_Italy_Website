---
title: Permissions
# Who may do what in the personal area: per Discord role and per person
# (server/permissions.js, /api/app/permissions). Shown to those holding
# `manage`; the shared admin account always may.
tool: settings
tab: permissions
pageTitle: Permissions
wide: true
permalink: /app/settings/permissions/
noindex: true
excludeFromSitemap: true
eleventyExcludeFromCollections: true
seoTitle: 'Permissions | AI Safety for Italy'
---
{% extends "app.njk" %}
{% block page %}
    <div class="perm-page" id="permPage">

      <div class="perm-layout">
        <nav class="perm-nav panel" aria-label="Roles and people">
          <p class="perm-nav-title">Discord roles</p>
          <div class="perm-nav-list" id="roleList"></div>
          <p class="form-note" id="noBot" hidden>The Discord bot is not set up here, so the server’s roles cannot be listed. Add a role by its id (Discord → Server settings → Roles → ⋯ → Copy role ID).</p>
          <form class="perm-add" id="addRole" hidden>
            <input class="form-input is-compact" id="roleId" required pattern="[0-9]{5,25}" placeholder="Role id" aria-label="Role id">
            <input class="form-input is-compact" id="roleName" required maxlength="100" placeholder="Role name" aria-label="Role name">
            <button class="btn btn-outline btn-sm" type="submit">Add role</button>
          </form>

          <p class="perm-nav-title">People</p>
          <div class="perm-nav-list" id="peopleList"></div>
          <form class="perm-add" id="addPerson">
            <select class="form-input is-compact" id="personPick" required aria-label="Person to add"></select>
            <button class="btn btn-outline btn-sm" type="submit">Add</button>
          </form>
          <p class="form-note" style="margin:0">Only people who have signed in here once can be added.</p>
        </nav>

        <section class="perm-detail panel" id="permDetail" aria-live="polite"></section>
      </div>

      <div class="form-error" id="permError" role="alert" hidden></div>
      <div class="action-bar">
        <p id="permStatus">Changes apply within a few minutes, and at once from the next sign-in.</p>
        <button class="btn btn-primary" type="button" id="savePerms">Save permissions</button>
      </div>
    </div>

<script src="/assets/js/meet/common.js" defer></script>
<script src="/assets/js/meet/app-common.js" defer></script>
<script src="/assets/js/meet/settings-permissions.js" defer></script>
{% endblock %}
