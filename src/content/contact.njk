---
layout: page.njk
title: Contact
permalink: /contact/
seoTitle: 'Contact AI Safety for Italy'
seoDescription: "Get in touch with AI Safety for Italy by email or LinkedIn, or fill in our interest form to connect with Italy's AI safety community."
---

<!-- Page hero -->
<section class="page-hero">
    <div class="container">
        <span class="eyebrow" data-en="{{ translations.en.nav.contact }}" data-it="{{ translations.it.nav.contact }}">{{ translations.en.nav.contact }}</span>
        <h1 data-en="{{ contact.hero.title }}" data-it="{{ contact.hero.title_it }}">{{ contact.hero.title }}</h1>
        <p class="lede" data-en="{{ contact.hero.subtitle }}" data-it="{{ contact.hero.subtitle_it }}">{{ contact.hero.subtitle }}</p>
    </div>
</section>

{% include "contact-form.njk" %}

<!-- CTA Section -->
<section class="section" style="padding-top: 0;">
    <div class="container">
        <div class="cta-band reveal">
            <h2 data-en="{{ contact.cta.title }}" data-it="{{ contact.cta.title_it }}">{{ contact.cta.title }}</h2>
            <p data-en="{{ contact.cta.description }}" data-it="{{ contact.cta.description_it }}">{{ contact.cta.description }}</p>
            <a href="{{ site.forms.mailingList }}" class="btn"
               target="_blank" rel="noopener noreferrer"
               data-en="{{ contact.cta.button_text }}" data-it="{{ contact.cta.button_text_it }}">{{ contact.cta.button_text }}</a>
        </div>
    </div>
</section>
