---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{#- Every page is listed once per locale. The alternates are built from the
    page's `basePath` (its locale-independent path) rather than from page.url,
    so an Italian entry advertises /about/ and /it/about/ — not /it/it/about/.
    A page without a basePath is single-language and gets no alternates. -#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {%- for entry in collections.all %}
  {%- if entry.url and not entry.data.excludeFromSitemap %}
  {%- set base = entry.data.basePath %}
  <url>
    <loc>https://aisafetycommunity.it{{ entry.url }}</loc>
    <lastmod>{{ entry.date | date("Y-m-d") }}</lastmod>
    <changefreq>
      {%- if base == "/" -%}weekly
      {%- elif base == "/initiatives/" or base == "/community/" -%}monthly
      {%- elif base == "/about/" or base == "/faq/" -%}monthly
      {%- else -%}yearly
      {%- endif -%}
    </changefreq>
    <priority>
      {%- if base == "/" -%}1.0
      {%- elif base == "/about/" -%}0.9
      {%- elif base == "/faq/" or base == "/initiatives/" -%}0.8
      {%- elif base == "/community/" -%}0.7
      {%- else -%}0.5
      {%- endif -%}
    </priority>
    {%- if base %}
    {%- for l in locales %}
    <xhtml:link rel="alternate" hreflang="{{ l.code }}" href="https://aisafetycommunity.it{{ l.prefix }}{{ base }}"/>
    {%- endfor %}
    <xhtml:link rel="alternate" hreflang="x-default" href="https://aisafetycommunity.it{{ base }}"/>
    {%- endif %}
  </url>
  {%- endif %}
  {%- endfor %}
</urlset>
