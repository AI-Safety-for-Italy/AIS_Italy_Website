{# The language switch is built from `basePath`, the page's locale-independent
   path: on /about/ it points at /it/about/ and vice versa. It carries
   data-lang-switch so the "localize" transform leaves its href alone — every
   other internal link on an Italian page gets moved under /it/.
   A page with no basePath (style-guide) is single-language and gets no switch. #}
{%- set altLocale = altLocales | first -%}
{%- set switchUrl = (altLocale.prefix + basePath) if basePath else "" -%}

<a class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:text-sm focus:rounded-md" style="background-color: var(--card-bg); color: var(--text-primary);" href="#main" data-en="{{ translations.en.a11y.skip_to_content }}" data-it="{{ translations.it.a11y.skip_to_content }}">{{ translations.en.a11y.skip_to_content }}</a>

{% include "icons.njk" %}

{# A thin bar above the header. The `announcements` in data/global.yaml win;
   without any, the bar points at the featured event. main.js runs them as a
   ticker, even a single one, so the bar stays one line tall on a phone: one
   message at a time crosses the bar from right to left, then the next one
   follows. Without JS (or with reduced motion) the first message just sits
   in the middle. Internal links stay in
   the tab, external ones open a new one. #}
{%- set featuredEvent = events.upcoming_events | selectattr("featured") | first -%}
{%- set anns = global.announcements -%}
{%- if not anns and featuredEvent -%}
{%- set anns = [{ text: featuredEvent.teaser, text_it: featuredEvent.teaser_it, link: featuredEvent.register_link, link_text: featuredEvent.register_text, link_text_it: featuredEvent.register_text_it }] -%}
{%- endif %}
{%- if anns and anns | length %}
<div class="announce-bar is-ticker" data-announce>
  <div class="announce-viewport">
    {%- for ann in anns %}
    <p class="announce-item{% if loop.first %} is-current{% endif %}">
      <span class="announce-dot" aria-hidden="true"></span>
      <span data-en="{{ ann.text }}" data-it="{{ ann.text_it or ann.text }}">{{ ann.text }}</span>
      {%- if ann.link %}
      <a href="{{ ann.link }}"{% if "://" in ann.link %} target="_blank" rel="noopener noreferrer"{% endif %} data-en="{{ ann.link_text }}" data-it="{{ ann.link_text_it or ann.link_text }}">{{ ann.link_text }}</a>
      {%- endif %}
    </p>
    {%- endfor %}
  </div>
</div>
{%- endif %}

{# Primary navigation: the sections a visitor chooses between. Active state
   compares basePath, so /it/about/ highlights About as well. Home is the
   logo; FAQ and Contact live in the footer and the mobile menu. #}
{%- set navItems = [
  { url: "/about/", key: "about" },
  { url: "/initiatives/", key: "events" },
  { url: "/mentorship/", key: "mentorship" },
  { url: "/community/", key: "community" },
  { url: "/resources/", key: "resources" }
] -%}

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="{{ t.a11y.home }}">
      <img src="/assets/img/ais4i-logo.svg" alt="" width="40" height="40">
      <span class="brand-name">AI Safety <span class="brand-accent">for Italy</span></span>
    </a>

    <nav class="main-nav" aria-label="{{ t.a11y.main_nav }}">
      {%- for item in navItems %}
      <a href="{{ item.url }}" {% if item.url == basePath %}class="active" aria-current="page"{% endif %} data-en="{{ translations.en.nav[item.key] }}" data-it="{{ translations.it.nav[item.key] }}">{{ translations.en.nav[item.key] }}</a>
      {%- endfor %}
    </nav>

    <div class="header-actions">
      {%- if switchUrl %}
      <a class="lang-btn" href="{{ switchUrl }}" hreflang="{{ altLocale.code }}" lang="{{ altLocale.code }}"
         aria-label="{{ altLocale.switchTitle }}" title="{{ altLocale.switchTitle }}" data-lang-switch><svg class="flag-icon" aria-hidden="true"><use href="#icon-flag-{{ altLocale.code }}"></use></svg><span class="sr-only">{{ altLocale.switchLabel }}</span></a>
      {%- endif %}
      <button class="icon-btn theme-btn" data-theme-toggle aria-label="{{ t.a11y.toggle_theme }}">
        {# Both icons are in the markup and CSS picks one off [data-theme], so the
           correct one is painted immediately and JS never swaps it. Each shows the
           theme you would switch TO. #}
        <svg class="theme-icon theme-icon--to-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="theme-icon theme-icon--to-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a href="{{ site.forms.mailingList }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary header-cta" data-en="Get involved" data-it="Partecipa">Get involved</a>
      <button id="menuToggle" class="menu-toggle" aria-expanded="false" aria-controls="mobileMenu" aria-label="{{ t.a11y.open_menu }}">
        <svg class="menu-icon-open" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg class="menu-icon-close" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobileMenu" class="mobile-menu hidden">
    <nav aria-label="{{ t.a11y.mobile_nav }}" class="mobile-nav">
      {%- for item in navItems %}
      <a href="{{ item.url }}" {% if item.url == basePath %}class="active" aria-current="page"{% endif %} data-en="{{ translations.en.nav[item.key] }}" data-it="{{ translations.it.nav[item.key] }}">{{ translations.en.nav[item.key] }}</a>
      {%- endfor %}
    </nav>
    <div class="mobile-secondary">
      <a href="/faq/" data-en="{{ translations.en.nav.faq }}" data-it="{{ translations.it.nav.faq }}">{{ translations.en.nav.faq }}</a>
      <a href="/contact/" data-en="{{ translations.en.nav.contact }}" data-it="{{ translations.it.nav.contact }}">{{ translations.en.nav.contact }}</a>
    </div>
    <div class="mobile-prefs">
      {%- if switchUrl %}
      <a class="mobile-pref" href="{{ switchUrl }}" hreflang="{{ altLocale.code }}" lang="{{ altLocale.code }}" data-lang-switch><svg class="flag-icon" aria-hidden="true"><use href="#icon-flag-{{ altLocale.code }}"></use></svg>{{ altLocale.switchTitle }}</a>
      {%- endif %}
      <button type="button" class="mobile-pref" data-theme-toggle>
        <span class="theme-label--to-dark" data-en="Dark theme" data-it="Tema scuro">Dark theme</span>
        <span class="theme-label--to-light" data-en="Light theme" data-it="Tema chiaro">Light theme</span>
      </button>
    </div>
    <a href="{{ site.forms.mailingList }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg w-full" data-en="Get involved" data-it="Partecipa">Get involved</a>
  </div>
</header>
