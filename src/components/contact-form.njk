<!-- Contact form (two-column: intro + channels on the left, form on the right) -->
<section class="section" id="contact-form">
    <div class="container">
        <div class="contact-grid">
            <!-- Left: intro + contact methods -->
            <div class="contact-side reveal">
                <h2 data-en="Got some questions or feedback?" data-it="Hai domande o feedback?">Got some questions or feedback?</h2>
                <p data-en="Feel free to fill out the form. We'd love to hear from you. You can also reach us directly through email or LinkedIn."
                   data-it="Compila il form qui accanto. Ci farebbe piacere sentirti. Puoi anche raggiungerci direttamente via email o LinkedIn.">Feel free to fill out the form. We'd love to hear from you. You can also reach us directly through email or LinkedIn.</p>

                <div class="contact-methods">
                    <a class="contact-method" href="mailto:{{ site.site.email }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                        {{ site.site.email }}
                    </a>
                    <a class="contact-method" href="{{ site.social.linkedin }}" target="_blank" rel="noopener noreferrer">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
                        LinkedIn — AI Safety Italia
                    </a>
                </div>
            </div>

            <!-- Right: form -->
            <form class="contact-form card reveal" onsubmit="return submitContactForm(event)" novalidate>
                <div class="form-row">
                    <div>
                        <label class="form-label" for="cf-name" data-en="Name" data-it="Nome">Name</label>
                        <input id="cf-name" name="name" type="text" required class="form-input"
                               placeholder="Your name" data-placeholder-en="Your name" data-placeholder-it="Il tuo nome">
                    </div>
                    <div>
                        <label class="form-label" for="cf-email" data-en="Email" data-it="Email">Email</label>
                        <input id="cf-email" name="email" type="email" required class="form-input"
                               placeholder="you@email.com" data-placeholder-en="you@email.com" data-placeholder-it="tu@email.com">
                    </div>
                </div>
                <div>
                    <label class="form-label" for="cf-message" data-en="Message" data-it="Messaggio">Message</label>
                    <textarea id="cf-message" name="message" rows="5" required class="form-input"
                              placeholder="Write your message…" data-placeholder-en="Write your message…" data-placeholder-it="Scrivi il tuo messaggio…"></textarea>
                </div>
                <div>
                    <button type="submit" class="btn btn-primary"
                            data-en="Send your message" data-it="Invia il messaggio">Send your message</button>
                </div>
                <p class="form-note"
                   data-en="Submitting opens your email client with the message pre-filled."
                   data-it="L'invio apre il tuo client email con il messaggio precompilato.">Submitting opens your email client with the message pre-filled.</p>
            </form>
        </div>
    </div>
</section>

<script>
    function submitContactForm(e) {
        e.preventDefault();
        var el = e.target.elements;
        var name = (el['name'].value || '').trim();
        var email = (el['email'].value || '').trim();
        var message = (el['message'].value || '').trim();
        if (!name || !email || !message) {
            (!name ? el['name'] : !email ? el['email'] : el['message']).focus();
            return false;
        }
        var subject = encodeURIComponent('Website contact: ' + name);
        var body = encodeURIComponent('Name: ' + name + '\nEmail: ' + email + '\n\n' + message);
        window.location.href = 'mailto:{{ site.site.email }}?subject=' + subject + '&body=' + body;
        return false;
    }
</script>
