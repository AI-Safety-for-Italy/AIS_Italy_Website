<!-- Contact form (two-column: intro + channels on the left, form on the right) -->
<section class="section" id="contact-form">
    <div class="container">
        <div class="contact-grid">
            <!-- Left: intro + contact methods -->
            <div class="contact-side reveal">
                <h2 data-en="Got some questions or feedback?" data-it="Hai domande o feedback?">Got some questions or feedback?</h2>
                <p data-en="Feel free to fill out the form. We'd love to hear from you. You can also reach us directly through email or LinkedIn."
                   data-it="Compila il form qui accanto. Ci farebbe piacere sentirti. Puoi anche raggiungerci direttamente via email o LinkedIn.">Feel free to fill out the form. We'd love to hear from you. You can also reach us directly through email or LinkedIn.</p>

                <div class="contact-methods">
                    <a class="contact-method" href="mailto:{{ site.site.email }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                        {{ site.site.email }}
                    </a>
                    <a class="contact-method" href="{{ site.social.linkedin }}" target="_blank" rel="noopener noreferrer">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
                        LinkedIn — AI Safety Italia
                    </a>
                </div>
            </div>

            <!-- Right: the form of the platform (/app/forms/, slug "contatti") -->
            <div class="contact-form card reveal">
                <h3 data-en="Write to us" data-it="Scrivici">Write to us</h3>
                <p data-en="Questions, feedback or a mistake to report on the site: tell us in a short form and we will reply by email."
                   data-it="Domande, feedback o un errore da segnalare sul sito: compila un breve form e ti rispondiamo via email.">Questions, feedback or a mistake to report on the site: tell us in a short form and we will reply by email.</p>
                <p>
                    <a class="btn btn-primary" href="/form/?f=contatti"
                       data-en="Send a message" data-it="Invia un messaggio">Send a message</a>
                </p>
            </div>
        </div>
    </div>
</section>
