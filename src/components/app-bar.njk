{# Navigation inside the meeting-poll tool. `appTab` (front matter) marks the
   current page. #}
<div class="admin-bar">
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/app/">Tools</a>
    <span aria-hidden="true">/</span>
    <span>Meeting polls</span>
  </nav>
  <nav class="admin-tabs" aria-label="Meeting polls">
    <a href="/app/polls/"{% if appTab == "polls" %} aria-current="page"{% endif %}>My polls</a>
    <a href="/app/polls/new/"{% if appTab == "new" %} aria-current="page"{% endif %}>New poll</a>
  </nav>
</div>
