{#- The frame of every page of the personal area (/app/): the sidebar with the
    tools, the top bar with the page's title, its tool's tabs and the search,
    and the page itself. A page uses it with

      {% extends "app.njk" %}
      front matter:  tool: <key in src/data/tools.js>   tab: <tab key>
                     pageTitle: …       (optional; else the tool's title)
                     bare: true         (optional; no top bar: the page draws its own)
      {% block actions %}…{% endblock %}   buttons on the right of the top bar
      {% block page %}…{% endblock %}      the page

    Tools are hidden until app-common.js knows the member's areas (and shows
    them at once from last visit's cache); the server checks every call
    anyway: hiding is only tidiness. -#}
{% extends "base.njk" %}
{% block content %}
{%- set current = tools | where("key", tool) | first %}
{#- Settings is not a tool, but has tabs too (src/data/appSettings.js). -#}
{%- if tool == appSettings.key %}{% set current = appSettings %}{% endif %}
<div class="ap-shell" id="apShell">
  <nav class="ap-nav" id="apNav" aria-label="Personal area">
    <div class="ap-nav-top">
      <a class="ap-brand" href="/app/">
        <img src="/assets/img/ais4i-logo.svg" alt="" width="28" height="28">
        <span>AI Safety <span class="ap-brand-accent">for Italy</span></span>
      </a>
      <button type="button" class="ap-icon-button ap-nav-close" id="apNavClose" aria-label="Close the menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>

    <a class="ap-link" href="/app/"{% if not tool %} aria-current="page"{% endif %}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
      <span class="ap-link-label">Home</span>
    </a>

    <p class="ap-nav-heading">Tools</p>
    {%- for t in tools %}
    {%- if not t.group %}
    <a class="ap-link" href="{{ t.url }}" data-tool="{{ t.key }}"{% if t.area %} data-area="{{ t.area }}" hidden{% endif %}{% if t.needsAny %} data-needs-any="{{ t.needsAny | join(' ') }}"{% endif %}{% if t.key == tool %} aria-current="page"{% endif %}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ t.icon | safe }}</svg>
      <span class="ap-link-label">{{ t.title }}</span>
      <span class="ap-count" data-ap-count="{{ t.key }}" hidden></span>
    </a>
    {%- elif loop.first or tools[loop.index0 - 1].group != t.group %}
    {#- A group (src/data/toolGroups.js): one entry opening on its tools,
        drawn at its first tool. Shown by app-common.js when one of them is. -#}
    {%- set g = toolGroups[t.group] %}
    {%- set members = tools | where("group", t.group) %}
    {%- set here = members | where("key", tool) | length %}
    <div class="ap-group{% if here %} is-open{% endif %}" data-group="{{ t.group }}" hidden>
      <button type="button" class="ap-link ap-group-toggle" aria-expanded="{{ 'true' if here else 'false' }}" aria-controls="apGroup-{{ t.group }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ g.icon | safe }}</svg>
        <span class="ap-link-label">{{ g.title }}</span>
        <svg class="ap-group-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
      </button>
      <div class="ap-sub" id="apGroup-{{ t.group }}">
        {%- for m in members %}
        <a class="ap-link" href="{{ m.url }}" data-tool="{{ m.key }}"{% if m.area %} data-area="{{ m.area }}" hidden{% endif %}{% if m.needsAny %} data-needs-any="{{ m.needsAny | join(' ') }}"{% endif %}{% if m.key == tool %} aria-current="page"{% endif %}>
          <span class="ap-link-label">{{ m.navLabel or m.title }}</span>
          <span class="ap-count" data-ap-count="{{ m.key }}" hidden></span>
        </a>
        {%- endfor %}
      </div>
    </div>
    {%- endif %}
    {%- endfor %}

    <div class="ap-nav-bottom">
      {#- Settings is in the profile menu below (app-common.js, showUser). -#}
      <div class="app-user ap-user" id="appUser"></div>
    </div>
  </nav>
  <div class="ap-scrim" id="apScrim" hidden></div>

  <div class="ap-main">
    {%- if not bare %}
    <header class="ap-top">
      <button type="button" class="ap-icon-button ap-menu" id="apMenu" aria-label="Open the menu" aria-controls="apNav" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
      <div class="ap-title">
        {#- The crumb back to the tool, on its inner pages only. -#}
        {%- if current and pageTitle and pageTitle != current.title %}<span class="ap-crumb"><a href="{{ current.url }}">{{ current.title }}</a></span>{% endif %}
        <h1 id="apTitle">{{ pageTitle or (current.title if current else title) }}</h1>
      </div>
      <div class="ap-top-actions">
        {% block actions %}{% endblock %}
        {#- Who can open this tool (app-common.js, /api/app/access). -#}
        {%- if current and current.faces %}<span class="ap-access" id="apAccess" data-tool="{{ current.key }}"{% if section %} data-section="{{ section }}"{% endif %}></span>{% endif %}
        <button type="button" class="ap-search" id="apSearchOpen" aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
          <span class="ap-search-label">Search</span>
          <kbd>Ctrl K</kbd>
        </button>
      </div>
      {%- if current and current.tabs.length %}
      <nav class="ap-tabs" aria-label="{{ current.title }}">
        {%- for tb in current.tabs %}
        <a href="{{ tb.url }}" data-tab="{{ tb.key }}"{% if tb.needs %} data-needs="{{ tb.needs }}" hidden{% endif %}{% if tb.admin %} class="admin-only"{% endif %}{% if tb.key == tab %} aria-current="page"{% endif %}>{{ tb.label }}</a>
        {%- endfor %}
      </nav>
      {%- endif %}
    </header>
    {%- else %}
    <button type="button" class="ap-icon-button ap-menu ap-menu-floating" id="apMenu" aria-label="Open the menu" aria-controls="apNav" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    {%- endif %}

    <div class="ap-page{% if wide %} is-wide{% endif %}{% if bare %} is-bare{% endif %}">
      {% block page %}{% endblock %}
    </div>
  </div>
</div>

{#- What the search (Ctrl+K) can open: the tools, their tabs and their actions.
    app-common.js keeps those the member may use. -#}
<script type="application/json" id="apTools">{{ tools | dump | safe }}</script>
<script type="application/json" id="apSettings">{{ appSettings | dump | safe }}</script>
<script type="application/json" id="apToolGroups">{{ toolGroups | dump | safe }}</script>
{% endblock %}
