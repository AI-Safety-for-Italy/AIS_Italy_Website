<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">
          <img src="/assets/img/ais4i-logo.svg" alt="" width="34" height="34">
          <strong>AI Safety for Italy</strong>
        </div>
        <p data-en="{{ translations.en.footer.about_description }}"
           data-it="{{ translations.it.footer.about_description }}">{{ translations.en.footer.about_description }}</p>
      </div>
      <div>
        <h4 data-en="{{ translations.en.footer.links_heading }}" data-it="{{ translations.it.footer.links_heading }}">{{ translations.en.footer.links_heading }}</h4>
        <ul class="footer-links">
          <li><a href="/about/" data-en="{{ translations.en.nav.about }}" data-it="{{ translations.it.nav.about }}">{{ translations.en.nav.about }}</a></li>
          <li><a href="/community/" data-en="{{ translations.en.nav.community }}" data-it="{{ translations.it.nav.community }}">{{ translations.en.nav.community }}</a></li>
          <li><a href="/resources/" data-en="{{ translations.en.nav.resources }}" data-it="{{ translations.it.nav.resources }}">{{ translations.en.nav.resources }}</a></li>
          <li><a href="/contact/" data-en="{{ translations.en.nav.contact }}" data-it="{{ translations.it.nav.contact }}">{{ translations.en.nav.contact }}</a></li>
        </ul>
      </div>
      <div>
        <h4 data-en="{{ translations.en.footer.connect_heading }}" data-it="{{ translations.it.footer.connect_heading }}">{{ translations.en.footer.connect_heading }}</h4>
        <ul class="footer-links">
          <li><a href="mailto:{{ site.site.email }}">{{ site.site.email }}</a></li>
          <li><a href="{{ site.social.linkedin }}" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span data-en="{{ translations.en.footer.copyright }}" data-it="{{ translations.it.footer.copyright }}">{{ translations.en.footer.copyright }}</span>
      <span class="footer-flag" aria-hidden="true"><i></i><i></i><i></i></span>
    </div>
  </div>
</footer>
