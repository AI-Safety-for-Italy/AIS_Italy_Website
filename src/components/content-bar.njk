{# Navigation inside the content tool (/app/content/). `appTab` (front matter)
   marks the current page. The Permissions tab is shown by content-common.js to
   those whose Discord roles include `manage`. #}
<div class="admin-bar">
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/app/">Tools</a>
    <span aria-hidden="true">/</span>
    <span>Site content</span>
  </nav>
  <nav class="admin-tabs" aria-label="Site content">
    <a href="/app/content/"{% if appTab == "content" %} aria-current="page"{% endif %}>Seminars &amp; events</a>
    <a href="/app/content/edit/"{% if appTab == "content-new" %} aria-current="page"{% endif %}>New</a>
    <a href="/app/content/permissions/" data-needs="manage" hidden{% if appTab == "content-permissions" %} aria-current="page"{% endif %}>Permissions</a>
  </nav>
</div>
