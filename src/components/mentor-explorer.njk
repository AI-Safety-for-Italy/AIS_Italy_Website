{# "Mentors and projects" on the mentorship page: a filterable grid of mentor
   cards, one track at a time, each opening a dialog with the full project. Data
   in data/mentors.yaml, track names from `tracks` in data/mentorship.yaml. The
   cards come in the order of mentorsBuild.arrange (server/mentors-build.js).
   Filtering, sorting, the "show all" button and the dialogs are
   initMentorExplorer in main.js; without it every card is listed and a card's
   link scrolls to its profile.
   Co-mentors are separate entries that list each other in `co_mentors`; one
   of them writes the project and the others take it from there (projectOf in
   .eleventy.js).
   Mentors published from the board may leave anything empty: without a photo
   the card shows initials, and an empty field shows nothing, not even its
   heading. A text in one language only shows in both. #}
{% set mx = mentors %}
{% set m = mentorship %}
{% set PREVIEW = 6 %}
{% set usedAreas = mx.mentors | pluckFlat("areas") %}

{% macro initials(name) -%}
{%- set parts = name | trim | split(" ") -%}
{{ (parts | first)[0] }}{{ (parts | last)[0] if (parts | length) > 1 else "" }}
{%- endmacro %}

{% macro avatar(mt, cls) -%}
{% if mt.photo %}
<img class="mentor-avatar {{ cls }}" src="{{ mt.photo }}" alt="" loading="lazy" width="160" height="160">
{% else %}
<span class="mentor-avatar mentor-initials {{ cls }}" aria-hidden="true">{{ initials(mt.name) }}</span>
{% endif %}
{%- endmacro %}

{# A text in both languages, each falling back to the other; nothing when both are empty. #}
{% macro both(tag, en, it, cls = "") -%}
{% if en or it %}<{{ tag }}{% if cls %} class="{{ cls }}"{% endif %} data-en="{{ en or it }}" data-it="{{ it or en }}">{{ en or it }}</{{ tag }}>{% endif %}
{%- endmacro %}

{# Role and affiliation, or nothing. #}
{% macro roleLine(x, tag = "p") -%}
{% if x.role or x.role_it or x.affiliation %}<{{ tag }} class="mentor-role">{{ both("span", x.role, x.role_it) }}{% if x.affiliation %}<span class="mentor-affiliation">{{ x.affiliation }}</span>{% endif %}</{{ tag }}>{% endif %}
{%- endmacro %}

{# The tracks a mentor takes part in, or only `only`. #}
{% macro trackPills(mt, only = "") -%}
{% if mt.tracks %}
<ul class="mentor-track-pills">
    {% for t in m.tracks %}
    {% if t.id in mt.tracks and (not only or t.id == only) %}
    <li class="mentor-track-pill is-{{ t.id }}" data-en="{{ t.title }}" data-it="{{ t.title_it }}">{{ t.title }}</li>
    {% endif %}
    {% endfor %}
</ul>
{% endif %}
{%- endmacro %}

{# The research areas of a mentor. #}
{% macro cardTags(mt) -%}
{% if mt.areas %}
<ul class="tags mentor-area-tags">
    {% for id in mt.areas %}
    {% set a = mx.research_areas | where("id", id) | first %}
    {% if a %}
    <li class="tag" data-en="{{ a.label }}" data-it="{{ a.label_it }}">{{ a.label }}</li>
    {% endif %}
    {% endfor %}
</ul>
{% endif %}
{%- endmacro %}

<section class="section section-alt mentors-section" id="mentors">
    <div class="container">
        <div class="rule-head reveal">
            <h2 data-en="{{ mx.title }}" data-it="{{ mx.title_it }}">{{ mx.title }}</h2>
            <p class="mono-label" data-mentor-count aria-live="polite"><span>{{ mx.mentors | length }}</span> <span data-en="mentors" data-it="mentor">mentors</span></p>
        </div>
        <p class="mentors-intro" data-en="{{ mx.intro }}" data-it="{{ mx.intro_it }}">{{ mx.intro }}</p>
        {% if mx.more_coming %}
        <p class="note-orange mentors-more-coming" data-en="{{ mx.more_coming }}" data-it="{{ mx.more_coming_it or mx.more_coming }}">{{ mx.more_coming }}</p>
        {% endif %}

        <div class="mentor-explorer" data-mentor-explorer data-preview="{{ PREVIEW }}">
            <div class="mentor-filters" data-mentor-filters hidden>
                <div class="mentor-filter-top">
                    <label class="mentor-search">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                        <span class="sr-only" data-en="Search mentors and projects" data-it="Cerca tra mentor e progetti">Search mentors and projects</span>
                        <input type="search" data-mentor-search autocomplete="off" placeholder="Search by name, topic, organisation…" data-placeholder-en="Search by name, topic, organisation…" data-placeholder-it="Cerca per nome, tema, ente…">
                    </label>
                    <span class="sr-only" id="mentor-filter-track" data-en="Track" data-it="Percorso">Track</span>
                    <div class="mentor-segmented" role="group" aria-labelledby="mentor-filter-track">
                        {% for t in m.tracks %}
                        <button type="button" class="mentor-segment" data-mentor-track="{{ t.id }}" aria-pressed="{{ 'true' if loop.first else 'false' }}" data-en="{{ t.tab }}" data-it="{{ t.tab_it }}">{{ t.tab }}</button>
                        {% endfor %}
                    </div>
                    <label class="mentor-sort">
                        <span class="sr-only" data-en="Sort by" data-it="Ordina per">Sort by</span>
                        <select data-mentor-sort>
                            <option value="" data-en="Suggested order" data-it="Ordine consigliato">Suggested order</option>
                            <option value="name" data-en="Name A–Z" data-it="Nome A–Z">Name A–Z</option>
                            <option value="project" data-en="Project A–Z" data-it="Progetto A–Z">Project A–Z</option>
                            <option value="organisation" data-en="Organisation A–Z" data-it="Ente A–Z">Organisation A–Z</option>
                        </select>
                    </label>
                </div>

                <span class="sr-only" id="mentor-filter-area" data-en="Research area" data-it="Area di ricerca">Research area</span>
                <div class="mentor-chips" role="group" aria-labelledby="mentor-filter-area">
                    {% for a in mx.research_areas %}
                    {% if a.id in usedAreas %}
                    <button type="button" class="mentor-chip" data-mentor-area="{{ a.id }}" aria-pressed="false" data-en="{{ a.label }}" data-it="{{ a.label_it }}">{{ a.label }}</button>
                    {% endif %}
                    {% endfor %}
                    <button type="button" class="mentor-reset" data-mentor-reset hidden data-en="Clear filters" data-it="Azzera filtri">Clear filters</button>
                </div>
            </div>

            <div class="mentor-grid">
                {% for mt in mx.mentors %}
                {% set p = mx.mentors | projectOf(mt) %}
                {% set hasOrientation = mt.orientation or mt.orientation_it %}
                {# The card previews the project: its summary, or the start of its description. #}
                {% set previewEn = p.summary or p.description if p else "" %}
                {% set previewIt = p.summary_it or p.description_it if p else "" %}
                {% set hasProject = p and (p.title or p.title_it or previewEn or previewIt) %}
                {% set hasBody = mt.tracks or hasProject or hasOrientation %}
                {# A mentor with no track yet stays on the site, under projects. #}
                <article class="mentor-card" data-mentor="{{ mt.id }}" data-tracks="{{ (mt.tracks or []) | join(' ') or 'projects' }}" data-areas="{{ (mt.areas or []) | join(' ') }}"
                    data-sort-name="{{ mt.name }}" data-sort-project="{{ p.title }}" data-sort-project-it="{{ p.title_it or p.title }}" data-sort-organisation="{{ mt.affiliation }}"
                    data-search="{{ [mt.name, mt.affiliation, mt.role, mt.role_it] | join(' ') | lower }}"
                    data-search-projects="{{ [p.title, p.title_it, p.summary, p.summary_it] | join(' ') | lower }}"
                    data-search-orientation="{{ [mt.orientation, mt.orientation_it] | join(' ') | lower }}">
                    {% if mt.co_mentors %}
                    <span class="mentor-co-badge">Co-mentor</span>
                    {% endif %}
                    <div class="mentor-card-head{% if not hasBody %} is-alone{% endif %}">
                        {{ avatar(mt, "") }}
                        <div class="mentor-card-who">
                            <h3 class="mentor-name">{{ mt.name }}</h3>
                            {{ roleLine(mt) }}
                        </div>
                    </div>
                    {% if hasBody %}
                    <div class="mentor-card-body">
                        {# With both, main.js shows the side of the track filter (the
                           project by default) and the card says the mentor does the
                           other too, instead of listing both tracks. #}
                        {% if not (hasProject and hasOrientation) %}{{ trackPills(mt) }}{% endif %}
                        {% if hasProject %}
                        <div data-mentor-view="projects">
                            {% if hasOrientation %}{{ trackPills(mt, "projects") }}{% endif %}
                            {{ both("p", p.title, p.title_it, "mentor-project-title") }}
                            {{ both("p", previewEn, previewIt, "mentor-summary") }}
                            {% if hasOrientation %}<p class="mentor-also" data-en="Also offers career orientation" data-it="Fa anche orientamento professionale">Also offers career orientation</p>{% endif %}
                        </div>
                        {% endif %}
                        {% if hasOrientation %}
                        <div data-mentor-view="orientation">
                            {% if hasProject %}{{ trackPills(mt, "orientation") }}{% endif %}
                            <p class="mentor-help-label" data-en="Can help with" data-it="Può aiutarti con">Can help with</p>
                            {{ both("p", mt.orientation, mt.orientation_it, "mentor-summary") }}
                            {% if hasProject %}<p class="mentor-also" data-en="Also supervises a project" data-it="Segue anche un progetto">Also supervises a project</p>{% endif %}
                        </div>
                        {% endif %}
                    </div>
                    {% endif %}
                    {# Without research areas the foot holds only the link: no line above it. #}
                    <div class="mentor-card-foot{% if not mt.areas %} is-empty{% endif %}">
                        {{ cardTags(mt) }}
                        <a class="mentor-open" href="#{{ mt.id }}" data-mentor-open="{{ mt.id }}" aria-haspopup="dialog">
                            <span class="sr-only" data-en="{{ 'Read the project' if p and not hasOrientation else 'Read the profile' }}" data-it="{{ 'Leggi il progetto' if p and not hasOrientation else 'Leggi il profilo' }}">{{ 'Read the project' if p and not hasOrientation else 'Read the profile' }}</span><span class="sr-only">: {{ mt.name }}</span>
                        </a>
                    </div>
                </article>
                {% endfor %}
            </div>

            <div class="mentor-empty" data-mentor-empty hidden>
                <p data-en="No mentor matches these filters." data-it="Nessun mentor corrisponde a questi filtri.">No mentor matches these filters.</p>
                <button type="button" class="btn btn-secondary btn-sm" data-mentor-reset data-en="Clear filters" data-it="Azzera filtri">Clear filters</button>
            </div>

            <div class="mentor-more" data-mentor-more-wrap hidden>
                <button type="button" class="btn btn-secondary" data-mentor-more aria-expanded="false"><span data-en="Show all mentors" data-it="Mostra tutti i mentor">Show all mentors</span> <span class="mentor-more-count">({{ mx.mentors | length }})</span></button>
            </div>
        </div>
    </div>

    {% for mt in mx.mentors %}
    {% set p = mx.mentors | projectOf(mt) %}
    {% set dHasProject = p and (p.title or p.title_it or p.description or p.description_it or p.summary or p.summary_it or p.mentee or p.mentee_it or p.deliverable or p.deliverable_it) %}
    {% set dHasOrientation = mt.orientation or mt.orientation_it %}
    {% set twoTracks = dHasProject and dHasOrientation %}
    <dialog class="mentor-dialog" id="{{ mt.id }}" aria-labelledby="{{ mt.id }}-name">
        <div class="mentor-dialog-inner">
            <button type="button" class="mentor-dialog-close" data-mentor-close>
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                <span class="sr-only" data-en="Close" data-it="Chiudi">Close</span>
            </button>

            <header class="mentor-dialog-head">
                {{ avatar(mt, "is-large") }}
                <div>
                    {% if mt.co_mentors %}
                    <span class="mentor-co-badge is-inline">Co-mentor</span>
                    {% endif %}
                    <h2 class="mentor-dialog-name" id="{{ mt.id }}-name">{{ mt.name }}</h2>
                    {{ roleLine(mt) }}
                    {% if mt.places or mt.language or mt.language_it %}
                    <p class="mentor-dialog-meta">
                        {% if mt.places %}<span data-en="{{ mt.places }} {{ 'place' if mt.places == 1 else 'places' }}" data-it="{{ mt.places }} {{ 'posto' if mt.places == 1 else 'posti' }}">{{ mt.places }} {{ 'place' if mt.places == 1 else 'places' }}</span>{% endif %}
                        {{ both("span", mt.language, mt.language_it) }}
                    </p>
                    {% endif %}
                    {% if mt.links %}
                    <ul class="mentor-links">
                        {% if mt.links.website %}<li><a href="{{ mt.links.website }}" target="_blank" rel="noopener noreferrer">Website</a></li>{% endif %}
                        {% if mt.links.linkedin %}<li><a href="{{ mt.links.linkedin }}" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>{% endif %}
                        {% if mt.links.scholar %}<li><a href="{{ mt.links.scholar }}" target="_blank" rel="noopener noreferrer">Google Scholar</a></li>{% endif %}
                        {% if mt.links.github %}<li><a href="{{ mt.links.github }}" target="_blank" rel="noopener noreferrer">GitHub</a></li>{% endif %}
                    </ul>
                    {% endif %}
                </div>
            </header>

            {% if mt.tracks or mt.areas %}
            <div class="mentor-dialog-tags">
                {{ trackPills(mt) }}
                {{ cardTags(mt) }}
            </div>
            {% endif %}

            {% if mt.co_mentors %}
            <section class="mentor-dialog-part">
                <p class="mono-label" data-en="Co-mentored with" data-it="In co-mentorship con">Co-mentored with</p>
                <ul class="mentor-co-list">
                    {% for id in mt.co_mentors %}
                    {% set co = mx.mentors | where("id", id) | first %}
                    {% if co %}
                    <li>
                        <a class="mentor-co" href="#{{ co.id }}" data-mentor-open="{{ co.id }}" aria-haspopup="dialog">
                            {{ avatar(co, "is-small") }}
                            <span class="mentor-co-who">
                                <span class="mentor-co-name">{{ co.name }}</span>
                                {{ roleLine(co, "span") }}
                            </span>
                        </a>
                    </li>
                    {% endif %}
                    {% endfor %}
                </ul>
            </section>
            {% endif %}

            {# With both, open() in main.js shows the block of the track filter
               and the other is a link away (data-mentor-switch). #}
            {% if p %}
            <div data-mentor-block="projects">
                {% if p.title or p.title_it or p.description or p.description_it or p.summary or p.summary_it %}
                <section class="mentor-dialog-part">
                    <p class="mono-label" data-en="Project" data-it="Progetto">Project</p>
                    {{ both("h3", p.title, p.title_it) }}
                    {{ both("p", p.description or p.summary, p.description_it or p.summary_it) }}
                </section>
                {% endif %}

                {% if p.mentee or p.mentee_it %}
                <section class="mentor-dialog-part">
                    <p class="mono-label" data-en="Who it is for" data-it="A chi si rivolge">Who it is for</p>
                    {{ both("p", p.mentee, p.mentee_it) }}
                </section>
                {% endif %}

                {% if p.deliverable or p.deliverable_it %}
                <section class="mentor-dialog-part">
                    <p class="mono-label" data-en="Deliverable" data-it="Risultato">Deliverable</p>
                    {{ both("p", p.deliverable, p.deliverable_it) }}
                </section>
                {% endif %}

                {% if twoTracks %}
                <p class="mentor-dialog-part mentor-switch-wrap" data-mentor-switch-wrap hidden>
                    <button type="button" class="mentor-switch" data-mentor-switch="orientation" data-en="{{ mt.name }} also offers career orientation: see what they can help with →" data-it="{{ mt.name }} fa anche orientamento professionale: guarda in cosa può aiutarti →">{{ mt.name }} also offers career orientation: see what they can help with →</button>
                </p>
                {% endif %}
            </div>
            {% endif %}

            {% if dHasOrientation %}
            <div data-mentor-block="orientation">
                <section class="mentor-dialog-part">
                    <p class="mono-label" data-en="Career orientation: can help with" data-it="Orientamento: può aiutarti con">Career orientation: can help with</p>
                    {{ both("p", mt.orientation, mt.orientation_it) }}
                </section>

                {% if twoTracks %}
                <p class="mentor-dialog-part mentor-switch-wrap" data-mentor-switch-wrap hidden>
                    <button type="button" class="mentor-switch" data-mentor-switch="projects" data-en="{{ mt.name }} also supervises a project: {{ p.title or p.title_it }} →" data-it="{{ mt.name }} segue anche un progetto: {{ p.title_it or p.title }} →">{{ mt.name }} also supervises a project: {{ p.title or p.title_it }} →</button>
                </p>
                {% endif %}
            </div>
            {% endif %}

            {% if mt.bio or mt.bio_it %}
            <section class="mentor-dialog-part">
                <p class="mono-label" data-en="About the mentor" data-it="Chi è">About the mentor</p>
                {{ both("p", mt.bio, mt.bio_it) }}
            </section>
            {% endif %}
        </div>
    </dialog>
    {% endfor %}
</section>
