{
  "buildCommand": "npm run build",
  "outputDirectory": "_site",
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(app|meet|it/meet)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(app|form|join|meet|it/meet|api)/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "devCommand": "npm start",
  "redirects": [
    {
      "source": "/app/content/permissions/",
      "destination": "/app/settings/permissions/",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/app/polls/",
      "permanent": true
    },
    {
      "source": "/admin/",
      "destination": "/app/polls/",
      "permanent": true
    },
    {
      "source": "/admin/new/",
      "destination": "/app/polls/new/",
      "permanent": true
    },
    {
      "source": "/admin/poll/",
      "destination": "/app/polls/poll/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "aisafetycommunity.it"
        }
      ],
      "destination": "https://www.ais4i.it/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.aisafetycommunity.it"
        }
      ],
      "destination": "https://www.ais4i.it/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "api/app.js": {
      "maxDuration": 60,
      "includeFiles": "data/events.yaml"
    },
    "api/poll.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/app/:route*",
      "destination": "/api/app?__route=:route*"
    }
  ]
}
